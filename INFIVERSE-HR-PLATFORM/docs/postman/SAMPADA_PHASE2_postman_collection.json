        ],
        "body": { "mode": "raw", "raw": "{\n  \"candidate_id\": \"60a7c2e5f1e4a2b3c4d5e6f7\",\n  \"job_id\": \"679a1b2c3d4e5f6789012345\",\n  \"feedback\": { \"quality\": 5, \"comments\": \"Good fit.\" }\n}" },
        "url": { "raw": "{{API_BASE}}/rl/feedback", "host": ["{{API_BASE}}"], "path": ["rl","feedback"] }
      }
    },
    {
      "name": "POST Payroll Visibility (placeholder)",
      "request": {
