{
  "info": {
    "name": "SAMPADA Phase2 - Signal Contract Tests",
    "_postman_id": "b6a1f8d0-1111-4000-8000-000000000001",
    "description": "Importable Postman collection for Phase 2 signal contract tests (placeholders).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "API_BASE", "value": "http://localhost:8000" },
    { "key": "API_KEY", "value": "REPLACE_WITH_API_KEY" },
    { "key": "CORRELATION_ID", "value": "3fa85f64-5717-4562-b3fc-2c963f66afa6" }
  ],
  "item": [
    {
      "name": "GET Top Matches",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{API_KEY}}" },
          { "key": "X-Correlation-Id", "value": "{{CORRELATION_ID}}" }
        ],
        "url": { "raw": "{{API_BASE}}/v1/match/679a1b2c3d4e5f6789012345/top?limit=5", "host": ["{{API_BASE}}"], "path": ["v1","match","679a1b2c3d4e5f6789012345","top"], "query": [{"key":"limit","value":"5"}] }
      }
    },
    {
      "name": "POST Batch Match",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{API_KEY}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Correlation-Id", "value": "{{CORRELATION_ID}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"job_ids\": [\"679a1b2c3d4e5f6789012345\", \"679a1b2c3d4e5f6789012346\"]\n}" },
        "url": { "raw": "{{API_BASE}}/v1/match/batch", "host": ["{{API_BASE}}"], "path": ["v1","match","batch"] }
      }
    },
    {
