          { "key": "X-Correlation-Id", "value": "{{CORRELATION_ID}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"workflow_id\": \"wf_abc123\",\n  \"workflow_type\": \"candidate_application\",\n  \"input_data\": {\n    \"candidate_id\": \"60a7c2e5f1e4a2b3c4d5e6f7\",\n    \"job_id\": \"679a1b2c3d4e5f6789012345\",\n    \"candidate_email\": \"alice@example.com\"\n  }\n}" },
        "url": { "raw": "{{API_BASE}}/v1/langgraph/trigger", "host": ["{{API_BASE}}"], "path": ["v1","langgraph","trigger"] }
      }
    },
    {
      "name": "POST RL Feedback",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{API_KEY}}" },
          { "key": "Content-Type", "value": "application/json" },
