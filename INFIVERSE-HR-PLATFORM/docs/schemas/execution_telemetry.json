{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecutionTelemetry",
  "description": "Schema for execution telemetry events emitted by tasking/execution systems (Niyantran) for observability and replay.",
  "type": "object",
  "properties": {
    "task_id": { "type": "string", "description": "Unique task identifier." },
    "executor_id": { "type": "string", "description": "Hashed or tokenized executor identifier (no raw PII)." },
    "start_ts": { "type": "string", "format": "date-time" },
    "end_ts": { "type": ["string","null"], "format": "date-time" },
    "status": { "type": "string", "enum": ["started","in_progress","completed","failed","cancelled"] },
    "trace_id": { "type": "string", "format": "uuid", "description": "Correlation trace id for cross-system correlation." },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "details": { "type": "object", "description": "Optional structured details about the execution (error codes, step names).", "additionalProperties": true }
  },
  "required": ["task_id","status","trace_id","start_ts"],
  "additionalProperties": false,
  "examples": [
    {
      "task_id": "task_98765",
      "executor_id": "hash_3f2a...",
      "start_ts": "2026-05-30T10:20:01Z",
      "end_ts": "2026-05-30T10:21:35Z",
      "status": "completed",
      "trace_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
      "duration_ms": 94500,
      "details": { "steps_executed": 5 }
    }
  ]
}
