{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkflowTrigger",
  "description": "Canonical schema for workflow triggers sent to LangGraph or recorded for replay.",
  "type": "object",
  "properties": {
    "workflow_id": { "type": "string", "description": "Unique workflow identifier." },
    "workflow_type": { "type": "string", "description": "Semantic workflow type (candidate_application|candidate_shortlisted|interview_scheduled|custom)." },
    "input_data": { "type": "object", "description": "Input payload for workflow execution.", "properties": {
      "candidate_id": { "type": "string" },
      "job_id": { "type": "string" },
      "candidate_email": { "type": "string", "format": "email" },
      "job_title": { "type": "string" }
    }, "required": ["candidate_id","job_id"] },
    "correlation_id": { "type": "string", "format": "uuid" },
    "initiator": { "type": "string", "description": "Actor that initiated the workflow (system|recruiter|client)." },
    "timestamp": { "type": "string", "format": "date-time" }
  },
  "required": ["workflow_id","workflow_type","input_data"],
  "additionalProperties": false,
  "examples": [
    {
      "workflow_id": "wf_abc123",
      "workflow_type": "candidate_application",
      "input_data": {
        "candidate_id": "60a7c2e5f1e4a2b3c4d5e6f7",
        "job_id": "679a1b2c3d4e5f6789012345",
        "candidate_email": "alice@example.com",
        "job_title": "Senior Python Developer"
      },
      "correlation_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
      "initiator": "client",
      "timestamp": "2026-05-30T10:16:00Z"
    }
  ]
}
