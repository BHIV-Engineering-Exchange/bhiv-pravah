{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(mitra_requests_total[5m])",
          "legendFormat": "Requests/sec",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Response Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(mitra_request_duration_seconds_bucket[5m]))",
          "legendFormat": "P95 Latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, rate(mitra_request_duration_seconds_bucket[5m]))",
          "legendFormat": "P50 Latency",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Enforcement Decisions",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "mitra_enforcement_allows_total",
          "legendFormat": "Allows",
          "refId": "A"
        },
        {
          "expr": "mitra_enforcement_blocks_total",
          "legendFormat": "Blocks",
          "refId": "B"
        },
        {
          "expr": "mitra_enforcement_rewrites_total",
          "legendFormat": "Rewrites",
          "refId": "C"
        }
      ]
    },
    {
      "title": "Active Instances",
      "type": "stat",
      "gridPos": { "h": 8, "w": 4, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "count(up{job=\"mitra-core\"} == 1)",
          "legendFormat": "Instances",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Error Rate",
      "type": "stat",
      "gridPos": { "h": 8, "w": 4, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(mitra_errors_total[5m])",
          "legendFormat": "Errors/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      }
    },
    {
      "title": "BHIV Product Integrations",
      "type": "table",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "expr": "mitra_integration_health",
          "legendFormat": "{{product}}",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["mitra", "bhiv", "enterprise"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "MITRA Enterprise Dashboard",
  "uid": "mitra-enterprise",
  "version": 1
}
