# =============================================================================
# Pravah Production Environment Configuration
# Target: Yotta Bare-Metal VM (Docker Compose + systemd)
#
# IMPORTANT: Replace all ##SECRET## and ##YOTTA_URL## placeholders before
# deploying to Yotta. Inject secrets via Yotta Secrets Manager or a
# secrets management tool — never commit real values to VCS.
# =============================================================================

# --- Core ---
ENVIRONMENT=prod
DEBUG=false
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# --- Production Flags (must be false in production) ---
DEMO_MODE=false
DEMO_FREEZE_MODE=false

# --- Pravah Service Ports ---
CONTROL_PLANE_PORT=7000
DECISION_BRAIN_PORT=8000
OBSERVER_PORT=8600
PRAVAH_OBSERVER_PORT=8600
REDIS_PORT=6379

# --- Redis (self-hosted container on Yotta VM) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=2
REDIS_MAX_MEMORY=512mb

# --- Gunicorn / Uvicorn Worker Counts ---
GUNICORN_WORKERS=4
UVICORN_WORKERS=2

# --- Docker Image Tag ---
IMAGE_TAG=prod

# --- Trace Signing Key (SSPL) ---
# REPLACE with actual secret via Yotta Secrets Manager
SSPL_SECRET_KEY=##SECRET:SSPL_SECRET_KEY##

# --- JWT / Auth ---
JWT_SECRET_KEY=##SECRET:JWT_SECRET_KEY##

# --- Deployment Settings ---
DEPLOYMENT_TIMEOUT=60
RETRY_COUNT=1
HEALTH_CHECK_INTERVAL=30

# --- Production Thresholds ---
LATENCY_THRESHOLD_MS=12000
LOW_SCORE_THRESHOLD=50
HIGH_HEART_RATE=110
LOW_OXYGEN_LEVEL=98

# --- Monitoring & Metrics ---
ENABLE_METRICS=true
DASHBOARD_PORT=9090

# --- CORS ---
BACKEND_CORS_ORIGINS=https://##YOTTA_URL:PRAVAH_FRONTEND_DOMAIN##
BACKEND_CORS_ORIGIN_REGEX=^https://.*\.yotta\.com$|^https://.*\.vercel\.app$

# --- Autonomy Gates ---
AUTONOMY_DECISIONS_ENABLED=true
AUTONOMY_LEARNING_ENABLED=false

# --- Emergency Freeze (Manual Override) ---
EMERGENCY_FREEZE_ENABLED=false
EMERGENCY_FREEZE_REASON=

# =============================================================================
# Observed Service URLs
# Replace ##YOTTA_URL:*## with actual production endpoints on Yotta or external
# =============================================================================

# Pravah internal services (Docker DNS — do NOT change unless using host network)
PRAVAH_CONTROL_PLANE=http://control-plane:7000
PRAVAH_MAIN_API=http://decision-brain:8000

# External observed services — set to real Yotta / production URLs
PRAVAH_GURUKUL_API=##YOTTA_URL:GURUKUL_BACKEND##
PRAVAH_HR_API=##YOTTA_URL:INFIVERSE_HR_PLATFORM##
PRAVAH_PARIKSHAK_API=##YOTTA_URL:PARIKSHAK_SYSTEM##
PRAVAH_CRM_API=##YOTTA_URL:CRM_API##
PRAVAH_PROMPT_RUNNER_API=##YOTTA_URL:PROMPT_RUNNER01##
PRAVAH_TRADE_BOT_API=##YOTTA_URL:TRADE_BOT##
PRAVAH_TTG_API=##YOTTA_URL:TTG##
PRAVAH_UNIGURU_API=##YOTTA_URL:UNIGURU_AI##
PRAVAH_WORKFLOW_BLACKHOLE_API=##YOTTA_URL:WORKFLOW_BLACKHOLE##
PRAVAH_BLOCKCHAIN_API=##YOTTA_URL:BLOCK_CHAIN_UPDATED##
PRAVAH_MASTERDB_API=##YOTTA_URL:BHIV_MASTERDB_INGESTION##
PRAVAH_MITRA_API=##YOTTA_URL:BHIV_MITRA##
PRAVAH_SVACS_API=##YOTTA_URL:BHIV_SVACS_UNIFIED_CORE##

# BHIV Runtime services
PRAVAH_BHIV_KARMA=##YOTTA_URL:BHIV_KARMA##
PRAVAH_BHIV_BUCKET=##YOTTA_URL:BHIV_BUCKET##
PRAVAH_BHIV_CORE=##YOTTA_URL:BHIV_CORE##
PRAVAH_BHIV_WORKFLOW=##YOTTA_URL:BHIV_WORKFLOW##
PRAVAH_BHIV_UAO=##YOTTA_URL:BHIV_UAO##
PRAVAH_BHIV_INSIGHT_CORE=##YOTTA_URL:BHIV_INSIGHT_CORE##
PRAVAH_BHIV_INSIGHT_FLOW_BRIDGE=##YOTTA_URL:BHIV_INSIGHT_FLOW_BRIDGE##
PRAVAH_BHIV_INSIGHT_FLOW_BACKEND=##YOTTA_URL:BHIV_INSIGHT_FLOW_BACKEND##
PRAVAH_BHIV_KESHAV=##YOTTA_URL:BHIV_KESHAV_4##
PRAVAH_BHIV_SARATHI=##YOTTA_URL:BHIV_SARATHI##