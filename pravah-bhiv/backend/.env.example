# ============================================================
# Pravah Production Environment Configuration
# Target: Bare-Metal VM with Docker Compose
# ============================================================
# INSTRUCTIONS:
# 1. Copy this file to .env on the VM at /opt/pravah/.env
# 2. Replace all ##PLACEHOLDER## values with actual values
# 3. NEVER commit real secrets to Git
# 4. Use the CI/CD secrets in GitHub for sensitive values
# ============================================================

# --- VM Network Configuration ---
# Set this to the VM's IP address (not localhost)
VM_IP=172.22.0.10

# --- Core Settings ---
ENVIRONMENT=prod
DEBUG=false
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# --- Production Flags (MUST be false in production) ---
DEMO_MODE=false
DEMO_FREEZE_MODE=false

# --- Service Ports ---
CONTROL_PLANE_PORT=7000
DECISION_BRAIN_PORT=8000
OBSERVER_PORT=8600
REDIS_PORT=6379

# --- Redis Configuration ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=2
REDIS_MAX_MEMORY=512mb

# --- Gunicorn / Uvicorn Worker Configuration ---
GUNICORN_WORKERS=4
UVICORN_WORKERS=2

# --- Docker Hub Configuration ---
# Set to your Docker Hub username (from GitHub secrets)
DOCKER_HUB_USERNAME=##YOUR_DOCKERHUB_USERNAME##
# Set to your Docker Hub password/token (from GitHub secrets)
DOCKER_HUB_PASSWORD=##YOUR_DOCKERHUB_PASSWORD##
# Docker Registry URL (default: docker.io)
DOCKER_REGISTRY=docker.io

# --- Secret Keys (Load from CI/CD secrets, NOT hardcoded) ---
# These should be injected by GitHub Actions during deployment
SSPL_SECRET_KEY=##WILL_BE_INJECTED_BY_CI/CD##
LINEAGE_SIGNING_KEY=##WILL_BE_INJECTED_BY_CI/CD##
JWT_SECRET_KEY=##WILL_BE_INJECTED_BY_CI/CD##

# --- Deployment Settings ---
DEPLOYMENT_TIMEOUT=60
RETRY_COUNT=3
HEALTH_CHECK_INTERVAL=30

# --- Production Thresholds ---
LATENCY_THRESHOLD_MS=12000
LOW_SCORE_THRESHOLD=50

# --- Monitoring & Metrics ---
ENABLE_METRICS=true
DASHBOARD_PORT=9090

# --- CORS Settings ---
BACKEND_CORS_ORIGINS=https://yourdomain.com
BACKEND_CORS_ORIGIN_REGEX=^https://.*\.yourdomain\.com$

# --- Autonomy & Emergency Controls ---
AUTONOMY_DECISIONS_ENABLED=true
AUTONOMY_LEARNING_ENABLED=false
EMERGENCY_FREEZE_ENABLED=false
EMERGENCY_FREEZE_REASON=

# ============================================================
# Observed Service URLs (External Integrations)
# These services will be accessed via VM_IP and their respective ports
# Replace with your actual service endpoints if different from VM_IP
# ============================================================
PRAVAH_DECISION_BRAIN=http://${VM_IP}:8010
PRAVAH_CONTROL_PLANE=http://${VM_IP}:7000
PRAVAH_OBSERVER=http://${VM_IP}:8600
PRAVAH_PROMETHEUS=http://${VM_IP}:9093
PRAVAH_GURUKUL_API=http://${VM_IP}:3000
PRAVAH_HR_API=http://${VM_IP}:8000
PRAVAH_PARIKSHAK_API=http://${VM_IP}:8080
PRAVAH_CRM_API=http://${VM_IP}:8001
PRAVAH_PROMPT_RUNNER_API=http://${VM_IP}:8001
PRAVAH_TRADE_BOT_API=http://${VM_IP}:8002
PRAVAH_TTG_API=http://${VM_IP}:3005
PRAVAH_UNIGURU_API=http://${VM_IP}:8003
PRAVAH_WORKFLOW_BLACKHOLE_API=http://${VM_IP}:5005
PRAVAH_BLOCKCHAIN_API=http://${VM_IP}:8004

# --- BHIV Services ---
PRAVAH_BHIV_KARMA=http://${VM_IP}:8000
PRAVAH_BHIV_BUCKET=http://${VM_IP}:8001
PRAVAH_BHIV_CORE=http://${VM_IP}:8002
PRAVAH_BHIV_WORKFLOW=http://${VM_IP}:8003
PRAVAH_BHIV_UAO=http://${VM_IP}:8004
PRAVAH_BHIV_INSIGHT_CORE=http://${VM_IP}:8005
PRAVAH_BHIV_INSIGHT_FLOW_BRIDGE=http://${VM_IP}:8006
PRAVAH_BHIV_INSIGHT_FLOW_BACKEND=http://${VM_IP}:8007
PRAVAH_BHIV_KESHAV=http://${VM_IP}:5000
PRAVAH_BHIV_SARATHI=http://${VM_IP}:9002
PRAVAH_MASTERDB_API=http://${VM_IP}:8000
PRAVAH_MITRA_API=http://${VM_IP}:8000
