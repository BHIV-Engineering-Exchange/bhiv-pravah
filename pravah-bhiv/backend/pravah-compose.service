[Unit]
Description=Pravah Multi-Agent CI/CD System (Docker Compose)
Documentation=https://github.com/your-repo/pravah
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes

# Set working directory
WorkingDirectory=/opt/pravah

# Load environment variables
EnvironmentFile=/opt/pravah/.env

# Pre-start: Pull latest images
ExecStartPre=-/usr/bin/docker compose pull --quiet

# Start services with prod profile
ExecStart=/usr/bin/docker compose --profile prod up -d

# Stop services
ExecStop=/usr/bin/docker compose down

# Restart on failure
OnFailure=pravah-compose-rollback.service

# User and group
User=root
Group=root

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pravah-compose

# Restart policy
Restart=on-failure
RestartSec=10s

# Timeout
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
