# BlackHole Blockchain — Environment Variables
# Copy this file to .env on the VM before running docker compose
# Command: cp .env.example .env
# NEVER commit .env to git

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── MongoDB (local container — no Atlas needed) ───────────────────────────────
# These credentials are used by the local MongoDB container inside Docker.
# Pick any username and strong password — MongoDB will be created with these.
MONGO_INITDB_ROOT_USERNAME=bhxadmin
MONGO_INITDB_ROOT_PASSWORD=BHX@Secure2025!
MONGO_INITDB_DATABASE=blackhole_wallet
MONGODB_URI=mongodb://bhxadmin:BHX@Secure2025!@blackhole-mongodb:27017/blackhole_wallet

# ── Signature Verification ────────────────────────────────────────────────────
# false = dev mode (unsigned transactions allowed)
# true  = production mode (every tx must have btcec wallet signature)
# Keep false until all clients are sending real signatures
SIGVERIFY_STRICT_MODE=false
PDV_STRICT_MODE=false
SARATHI_FAIL_CLOSED=false

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
DOCKER_MODE=true

# ── TLS (Nginx) ───────────────────────────────────────────────────────────────
# Self-signed cert is already in nginx/certs/cert.pem
# For production replace with Let's Encrypt cert
TLS_CERT_PATH=./nginx/certs/cert.pem
TLS_KEY_PATH=./nginx/certs/key.pem

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_RPS=100
