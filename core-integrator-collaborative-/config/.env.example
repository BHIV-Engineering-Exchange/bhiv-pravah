# Core Integrator Configuration
# Copy to repo-root .env and fill in real values.
# NEVER commit a .env file with real secrets.

# ============================================================
# COMPULSORY — required for runtime manager + sprint services
# ============================================================

# Authentication (required in production; all services must share the same key)
AUTH_ENABLED=true
AUTH_API_KEY=change-me-to-a-strong-api-key
AUTH_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# LLM Integration
GROQ_API_KEY=your_groq_api_key_here

# Python import path
PYTHONPATH=.:./src:./creator-core/Core-Integrator-Sprint-1.1

# Database Configuration (MongoDB Atlas)
USE_MONGODB=true
MONGODB_CONNECTION_STRING=mongodb+srv://user:password@cluster.mongodb.net/bhiv_production?retryWrites=true&w=majority
MONGODB_DATABASE_NAME=bhiv_production

# Primary external service URL (required when Prompt Runner is deployed separately)
# Note: Vercel/Render env vars do not expand other env vars in values.
PROMPT_RUNNER_URL=https://your-prompt-runner-host.onrender.com

# ============================================================
# OPTIONAL — defaults work for local/docker all-in-one deploy
# ============================================================

# --- Service URLs (override only for split/multi-host deploy) ---
# CREATOR_CORE_URL=https://your-creator-core-host.onrender.com
# BHIV_CORE_URL=https://your-bhiv-core-host.onrender.com
# INTEGRATION_BRIDGE_URL=https://your-bridge-host.onrender.com
# BUCKET_URL=https://your-bucket-host.onrender.com
# CET_URL=https://your-cet-host.onrender.com
# SARATHI_URL=https://your-sarathi-host.onrender.com
# GATE_URL=https://your-gate-host.onrender.com
# CONTROL_PLANE_URL=https://your-control-plane-host.onrender.com
# TELEMETRY_URL=https://your-telemetry-host.onrender.com

# --- SHAKTI sprint: telemetry autonomous loop ---
TELEMETRY_AUTO_ENABLED=true
TELEMETRY_AUTO_INTERVAL_SECONDS=30

# --- API / platform (Vercel only) ---
VERCEL_ENV=production
VERCEL_REGION=auto

# --- Storage Configuration (AWS S3) ---
USE_EXTERNAL_STORAGE=false
AWS_S3_BUCKET=your-bhiv-bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# --- Feature Flags ---
ENABLE_BHIV_FORWARD=true
ENABLE_REMOTE_EXECUTION=true
ENABLE_TELEMETRY=true

# --- Logging ---
LOG_LEVEL=INFO

# --- Legacy/local options ---
DB_PATH=db/context.db
NOOPUR_BASE_URL=http://localhost:5001
INTEGRATOR_USE_NOOPUR=false
NOOPUR_API_KEY=

# --- Security (SSPL Phase III) ---
SSPL_ENABLED=false
SSPL_ALLOW_DRIFT_SECONDS=300
