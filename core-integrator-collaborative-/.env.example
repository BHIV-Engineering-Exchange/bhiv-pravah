# ============================================================
# .env.example — Copy to .env and fill in real values
# NEVER commit a .env file with real secrets
# ============================================================

# ============================================================
# COMPULSORY — required for runtime manager + sprint services
# ============================================================

# Authentication (required in production; all services must share the same key)
AUTH_ENABLED=true
AUTH_API_KEY=change-me-to-a-strong-api-key
AUTH_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# LLM (required by Prompt Runner / Creator Core)
GROQ_API_KEY=your_groq_api_key_here

# Python import path (required for multi-service startup)
PYTHONPATH=.:./src:./creator-core/Core-Integrator-Sprint-1.1

# Database (set USE_MONGODB=true if using Atlas; false uses local SQLite via DB_PATH)
USE_MONGODB=false
MONGODB_CONNECTION_STRING=mongodb+srv://user:password@cluster.mongodb.net/?appName=Creator-core
MONGODB_DATABASE_NAME=core_integrator

# Primary external service URL (required when Prompt Runner is deployed separately)
PROMPT_RUNNER_URL=http://127.0.0.1:8003

# ============================================================
# OPTIONAL — defaults work for local/docker all-in-one deploy
# ============================================================

# --- Service URLs (override only for split/multi-host deploy) ---
# Local/docker single-container defaults are in config/services.yml (127.0.0.1:port).
# Uncomment and set when services run on separate hosts (e.g. Render).
# CREATOR_CORE_URL=http://127.0.0.1:8000
# BHIV_CORE_URL=http://127.0.0.1:8001
# INTEGRATION_BRIDGE_URL=http://127.0.0.1:8004
# BUCKET_URL=http://127.0.0.1:8005
# CET_URL=http://127.0.0.1:8006
# SARATHI_URL=http://127.0.0.1:8007
# GATE_URL=http://127.0.0.1:8008
# CONTROL_PLANE_URL=http://127.0.0.1:8009
# TELEMETRY_URL=http://127.0.0.1:8010

# Per-service host/port/protocol overrides (alternative to *_URL above)
# PROMPT_RUNNER_HOST=127.0.0.1
# PROMPT_RUNNER_PORT=8003
# PROMPT_RUNNER_PROTOCOL=http

# --- SHAKTI sprint: telemetry autonomous loop ---
TELEMETRY_AUTO_ENABLED=true
TELEMETRY_AUTO_INTERVAL_SECONDS=30

# --- Database (local fallback when USE_MONGODB=false) ---
DB_PATH=data/context.db

# --- Logging ---
LOG_LEVEL=INFO

# --- Timeouts ---
REQUEST_TIMEOUT=30
PIPELINE_TIMEOUT=60
VIDEO_SERVICE_TIMEOUT=300

# --- Noopur integration ---
INTEGRATOR_USE_NOOPUR=false
NOOPUR_BASE_URL=http://localhost:5001
NOOPUR_API_KEY=

# --- Feature flags ---
SSPL_ENABLED=false
SSPL_ALLOW_DRIFT_SECONDS=300
DISABLE_VIDEO_SERVICE=true
ENABLE_BHIV_FORWARD=true

# --- Rate limiting (optional Redis) ---
# REDIS_URL=
# RATE_LIMIT_IP_PER_MIN=60
# RATE_LIMIT_USER_PER_MIN=30

# --- External storage (optional) ---
# USE_EXTERNAL_STORAGE=false
# AWS_S3_BUCKET=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
