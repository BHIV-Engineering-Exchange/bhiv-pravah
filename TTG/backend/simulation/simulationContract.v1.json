{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "simulationContract.v1",
  "title": "Simulation Input Contract v1",
  "description": "Canonical input contract for the simulation node. Any system sending a simulation request MUST conform to this schema. No domain-specific fields allowed at the top level.",
  "type": "object",
  "additionalProperties": false,

  "required": ["trace_id", "execution_id", "domain", "scenario", "entities", "behaviors"],

  "properties": {

    "trace_id": {
      "type": "string",
      "minLength": 1,
      "description": "Globally unique identifier for this simulation trace. Used for replay and result retrieval."
    },

    "execution_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for this execution run. Different from trace_id — one trace can have multiple executions."
    },

    "domain": {
      "type": "string",
      "minLength": 1,
      "description": "The domain this simulation belongs to. e.g. maritime, education, nicai, aiaic, svacs, samruddhi. No logic is derived from this — it is metadata only."
    },

    "scenario": {
      "type": "string",
      "minLength": 1,
      "description": "The scenario label within the domain. e.g. patrol_route, classroom_session, threat_response. Metadata only — no behavior is inferred from this."
    },

    "ticks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "description": "Number of simulation ticks to run. Optional — defaults to 10 if not provided."
    },

    "entities": {
      "type": "array",
      "minItems": 1,
      "description": "All entities that exist in the simulation. Each entity must declare its own type, position, and behaviors explicitly.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "position", "behaviors"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": ["vessel", "obstacle", "zone", "marker", "agent"],
            "description": "Closed set — no domain-specific types allowed."
          },
          "position": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3,
            "description": "[x, y, z]"
          },
          "rotation": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3,
            "description": "[rx, ry, rz] — optional, defaults to [0,0,0]"
          },
          "velocity": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3,
            "description": "[vx, vy, vz] — optional, defaults to [0,0,0]"
          },
          "state": {
            "type": "string",
            "enum": ["active", "idle", "stopped", "destroyed"],
            "description": "Initial state — optional, defaults to active."
          },
          "behaviors": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "description": "List of behavior IDs assigned to this entity. Must reference IDs declared in the behaviors array."
          },
          "meta": {
            "type": "object",
            "description": "Arbitrary domain metadata. Passed through to engine as-is. No logic is derived from this."
          }
        }
      }
    },

    "behaviors": {
      "type": "array",
      "minItems": 1,
      "description": "All behavior definitions. Each behavior must declare its script explicitly — no inference from domain or scenario.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "script", "params"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "script": {
            "type": "string",
            "enum": ["patrol", "idle", "move_to", "flee", "anchor", "track"],
            "description": "Closed set — only these SumScript behavior scripts are valid."
          },
          "params": {
            "type": "object",
            "description": "Parameters for the behavior script. Shape depends on script type.",
            "properties": {
              "target":     { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
              "target_id":  { "type": "string" },
              "speed":      { "type": "number", "minimum": 0 },
              "threshold":  { "type": "number", "minimum": 0 },
              "threat":     { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
              "waypoints": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": { "type": "number" },
                  "minItems": 3,
                  "maxItems": 3
                }
              }
            }
          }
        }
      }
    },

    "rules": {
      "type": "array",
      "description": "Simulation rules. Optional — if omitted, no rules are applied.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "trigger", "condition", "action"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "type": "string",
            "enum": ["on_tick", "on_collision", "on_zone_enter", "on_zone_exit", "on_state_change"],
            "description": "Closed set — only these triggers are valid."
          },
          "condition": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "op", "value"],
            "properties": {
              "field":  { "type": "string", "minLength": 1 },
              "op":     { "type": "string", "enum": ["eq", "neq", "gt", "lt", "gte", "lte"] },
              "value":  {},
              "target": { "type": "string", "description": "Optional entity_id to scope this condition to." }
            }
          },
          "action": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["set_state", "emit_event", "flag_entity", "block_entity", "log"],
                "description": "Closed set — only these action types are valid."
              },
              "params": { "type": "object" }
            }
          },
          "enabled": {
            "type": "boolean",
            "description": "Optional — defaults to true."
          }
        }
      }
    },

    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "description": "Simulation-level constraints. Optional. No game_mode allowed here.",
      "properties": {
        "movement": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "speed":       { "type": "number", "minimum": 0 },
            "jump_height": { "type": "number", "minimum": 0 }
          }
        },
        "physics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gravity":         { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
            "friction":        { "type": "number", "minimum": 0 },
            "bounce":          { "type": "number", "minimum": 0 },
            "air_resistance":  { "type": "number", "minimum": 0 },
            "collision_force": { "type": "number", "minimum": 0 }
          }
        },
        "player_params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "health": { "type": "number", "minimum": 0 },
            "jetpack": { "type": "boolean" }
          }
        }
      }
    }
  }
}
