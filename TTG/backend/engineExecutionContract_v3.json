{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Engine Execution Contract v3.0",
  "description": "Canonical frozen contract for the TANTRA-ready BHIV Simulation & Execution Node. This is the single source of truth shared between Rudra (pipeline) and Atharva (execution). No modifications allowed by either side.",
  "version": "3.0.0",
  "frozen": true,
  "authority": "Rudra Parmeshwar — Pipeline Authority",
  "consumers": ["Atharva Sharma — Execution Node", "NICAI", "Samruddhi"],

  "rules": {
    "contract_is_final": "No schema changes during integration. No temporary fields. No interpretation differences.",
    "execution_is_passive": "Atharva accepts contract, runs simulation, emits events. Nothing else.",
    "pipeline_is_authority": "Only pipeline talks to Mitra. Only pipeline decides ALLOW/FLAG/BLOCK. Execution only runs when passed.",
    "no_bypass": "No execution without ALLOW. No stub decisions. No fallback paths."
  },

  "required_fields": [
    "execution_id",
    "trace_id",
    "game_mode",
    "entities",
    "physics",
    "scoring"
  ],

  "optional_fields": [
    "scene",
    "movement",
    "camera",
    "spawn_rules",
    "player_params"
  ],

  "stripped_fields": [
    "domain",
    "decisionEnvelope",
    "_source",
    "context",
    "tasks",
    "output_format",
    "module",
    "intent",
    "world_params",
    "data"
  ],

  "type": "object",

  "properties": {

    "execution_id": {
      "type": "string",
      "required": true,
      "description": "Unique execution identifier. Format: exec_<timestamp>_<hash>. Stamped by pipeline. Never modified by execution layer.",
      "example": "exec_1777353996503_0e584482"
    },

    "trace_id": {
      "type": "string",
      "required": true,
      "description": "Distributed trace ID. Flows unchanged through pipeline → enforcement → execution → events → artifacts. Never mutated.",
      "example": "trace_1777353996503"
    },

    "game_mode": {
      "type": "string",
      "required": true,
      "enum": ["runner", "sidescroller", "open_scene"],
      "description": "Game mode. Determines entity layout, behavior scripts, and simulation parameters.",
      "mapping": {
        "runner": "Linear movement, obstacles in path, goal zone at end",
        "sidescroller": "Side-scrolling movement, platforms, jump mechanics",
        "open_scene": "Arena mode, enemies track player, patrol behaviors"
      }
    },

    "scene": {
      "type": "object",
      "required": false,
      "description": "Scene configuration. Defaults applied if omitted.",
      "properties": {
        "scene_id": {
          "type": "string",
          "description": "Scene identifier. Format: scene_<game_mode>",
          "example": "scene_runner"
        },
        "ambient_light": {
          "type": "array",
          "items": { "type": "number", "minimum": 0, "maximum": 1 },
          "minItems": 3,
          "maxItems": 3,
          "description": "RGB ambient light [r, g, b]",
          "default": [0.6, 0.6, 0.6]
        },
        "skybox": {
          "type": "string",
          "description": "Skybox asset name",
          "default": "default_sky"
        }
      }
    },

    "entities": {
      "type": "array",
      "required": true,
      "minItems": 1,
      "description": "Entity spawn instructions. Built by contractAdapter from execution schema. Each entity has id, type, transform.",
      "items": {
        "type": "object",
        "required": ["id", "type", "transform"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique entity identifier",
            "examples": ["player_1", "obstacle_spawner", "PLAYER", "OBSTACLE_1", "ZONE_GOAL"]
          },
          "type": {
            "type": "string",
            "enum": ["player", "npc", "object", "obstacle", "spawner", "enemy", "platform", "pickup"],
            "description": "Entity type"
          },
          "transform": {
            "type": "object",
            "required": ["position", "rotation", "scale"],
            "properties": {
              "position": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 3,
                "maxItems": 3,
                "description": "World position [x, y, z]"
              },
              "rotation": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 3,
                "maxItems": 3,
                "description": "Rotation in degrees [x, y, z]"
              },
              "scale": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 3,
                "maxItems": 3,
                "description": "Scale [x, y, z]",
                "default": [1, 1, 1]
              }
            }
          },
          "material": {
            "type": "object",
            "required": false,
            "properties": {
              "shader": { "type": "string", "default": "standard" },
              "texture": { "type": "string" },
              "color": {
                "type": "array",
                "items": { "type": "number", "minimum": 0, "maximum": 1 },
                "minItems": 3,
                "maxItems": 3
              }
            }
          },
          "components": {
            "type": "object",
            "required": false,
            "properties": {
              "mesh": { "type": "string" },
              "collider": {
                "type": "string",
                "enum": ["box", "sphere", "capsule", "mesh"],
                "default": "box"
              },
              "script": { "type": "string" }
            }
          }
        }
      }
    },

    "physics": {
      "type": "object",
      "required": true,
      "description": "Physics parameters. gravity is required. All others have defaults.",
      "required_subfields": ["gravity"],
      "properties": {
        "gravity": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3,
          "description": "Gravity vector [x, y, z]",
          "examples": {
            "standard": [0, -9.8, 0],
            "maritime": [0, 0, 0],
            "low_gravity": [0, -3.0, 0]
          }
        },
        "friction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5,
          "description": "Surface friction coefficient"
        },
        "bounce": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.3,
          "description": "Bounciness / restitution"
        },
        "air_resistance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.1,
          "description": "Air drag coefficient"
        },
        "collision_force": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 2,
          "default": 1.0,
          "description": "Collision impact multiplier"
        }
      }
    },

    "movement": {
      "type": "object",
      "required": false,
      "description": "Player movement parameters. Defaults applied if omitted.",
      "properties": {
        "speed": {
          "type": "number",
          "minimum": 1,
          "maximum": 15,
          "default": 5,
          "description": "Movement speed units/tick. Drives SimEngine behavior target distance and patrol radius."
        },
        "jump_height": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "default": 0,
          "description": "Jump force / height. 0 = no jump."
        }
      }
    },

    "camera": {
      "type": "object",
      "required": false,
      "description": "Camera configuration. Consumed by execution layer only — not used by SimEngine.",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["third_person", "side_view", "top_down"],
          "default": "third_person"
        },
        "distance": {
          "type": "number",
          "minimum": 5,
          "maximum": 20,
          "default": 10
        }
      }
    },

    "spawn_rules": {
      "type": "object",
      "required": false,
      "description": "Entity spawning rules. Drives obstacle count and simulation duration.",
      "properties": {
        "obstacles": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "default": 0,
          "description": "Number of obstacle entities. Drives hit probability in SimEngine."
        },
        "frequency": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 10,
          "default": 2.0,
          "description": "Spawn frequency in seconds. Drives simulation max ticks: max(15, floor(40/frequency))."
        },
        "distance": {
          "type": "number",
          "minimum": 5,
          "maximum": 50,
          "default": 10,
          "description": "Distance between spawns"
        }
      }
    },

    "scoring": {
      "type": "object",
      "required": true,
      "description": "Score calculation rules and end conditions.",
      "required_subfields": ["rules"],
      "properties": {
        "rules": {
          "type": "object",
          "required": true,
          "properties": {
            "distance": {
              "type": "number",
              "minimum": 0,
              "default": 1,
              "description": "Points per distance unit"
            },
            "collectibles": {
              "type": "number",
              "minimum": 0,
              "default": 0,
              "description": "Points per collectible"
            },
            "time": {
              "type": "number",
              "minimum": 0,
              "default": 0,
              "description": "Points per second"
            }
          }
        },
        "end_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["collision", "time_limit", "distance_goal", "score_goal"]
          },
          "default": ["collision"],
          "description": "Win/lose conditions"
        }
      }
    },

    "player_params": {
      "type": "object",
      "required": false,
      "description": "Player-specific parameters.",
      "properties": {
        "health": {
          "type": "number",
          "minimum": 1,
          "maximum": 100,
          "default": 3,
          "description": "Player health / lives. Drives enemy count in open_scene mode."
        },
        "jetpack": {
          "type": "boolean",
          "default": false,
          "description": "Enable jetpack ability. Gives 50% damage reduction in SimEngine."
        }
      }
    }
  },

  "events_from_execution": {
    "description": "Events Atharva's execution layer MUST emit back to backend via Socket.IO /engine namespace. Every event must be HMAC-signed.",
    "signing": {
      "method": "HMAC-SHA256",
      "secret_env": "ENGINE_SHARED_SECRET",
      "format": "{ payload, nonce, ts, sig }"
    },
    "required_events": [
      {
        "event": "job_ack",
        "payload": { "jobId": "string", "status": "received" },
        "when": "Immediately on receiving job:dispatch"
      },
      {
        "event": "job_started",
        "payload": { "job_id": "string", "timestamp": "number" },
        "when": "When job execution begins"
      },
      {
        "event": "job_progress",
        "payload": { "job_id": "string", "progress": "0-100", "timestamp": "number" },
        "when": "Optional — mid-execution progress"
      },
      {
        "event": "job_completed",
        "payload": { "job_id": "string", "result": { "success": true }, "timestamp": "number" },
        "when": "When job finishes successfully"
      },
      {
        "event": "game:started",
        "payload": {
          "game_mode": "string",
          "speed": "number",
          "gameplay_contract": "object — the full contract received",
          "trace_id": "string",
          "execution_id": "string"
        },
        "when": "After START_LOOP job completes. gameplay_contract MUST be included — triggers SimEngine."
      },
      {
        "event": "telemetry",
        "payload": { "fps": "number", "score": "number", "lives": "number", "duration": "number" },
        "when": "Every second during game loop"
      },
      {
        "event": "game:ended",
        "payload": { "reason": "player_death|time_up", "final_score": "number", "duration": "number" },
        "when": "When game loop ends"
      }
    ]
  },

  "examples": {
    "runner_fast": {
      "execution_id": "exec_1777353996503_0e584482",
      "trace_id": "trace_1777353996503",
      "game_mode": "sidescroller",
      "scene": {
        "scene_id": "scene_sidescroller",
        "ambient_light": [0.6, 0.6, 0.6],
        "skybox": "default_sky"
      },
      "entities": [
        {
          "id": "player_1",
          "type": "player",
          "transform": { "position": [0, 0, 0], "rotation": [0, 0, 0], "scale": [1, 1, 1] },
          "material": { "shader": "standard", "texture": "player_skin", "color": [1, 1, 1] },
          "components": { "mesh": "player", "collider": "box", "script": "runner_controller" }
        },
        {
          "id": "obstacle_spawner",
          "type": "spawner",
          "transform": { "position": [0, 0, 0], "rotation": [0, 0, 0], "scale": [1, 1, 1] }
        }
      ],
      "physics": {
        "gravity": [0, -9.8, 0],
        "friction": 0.5,
        "bounce": 0.3,
        "air_resistance": 0.1,
        "collision_force": 1.0
      },
      "movement": { "speed": 8, "jump_height": 5 },
      "camera": { "type": "third_person", "distance": 10 },
      "spawn_rules": { "obstacles": 2, "frequency": 2, "distance": 10 },
      "scoring": {
        "rules": { "distance": 1, "collectibles": 10, "time": 0 },
        "end_conditions": ["collision"]
      },
      "player_params": { "health": 3, "jetpack": false }
    },

    "arena_hard": {
      "execution_id": "exec_arena_001",
      "trace_id": "trace_arena_001",
      "game_mode": "open_scene",
      "scene": {
        "scene_id": "scene_open_scene",
        "ambient_light": [0.4, 0.4, 0.6],
        "skybox": "night_sky"
      },
      "entities": [
        {
          "id": "player_1",
          "type": "player",
          "transform": { "position": [0, 0, 0], "rotation": [0, 0, 0], "scale": [1, 1, 1] }
        },
        {
          "id": "enemy_spawner",
          "type": "enemy",
          "transform": { "position": [50, 0, 0], "rotation": [0, 0, 0], "scale": [1, 1, 1] }
        }
      ],
      "physics": {
        "gravity": [0, -9.8, 0],
        "friction": 0.5,
        "bounce": 0.0,
        "air_resistance": 0.1,
        "collision_force": 1.5
      },
      "movement": { "speed": 6, "jump_height": 0 },
      "camera": { "type": "top_down", "distance": 20 },
      "spawn_rules": { "obstacles": 5, "frequency": 1.5, "distance": 8 },
      "scoring": {
        "rules": { "distance": 0, "collectibles": 50, "time": 0 },
        "end_conditions": ["collision"]
      },
      "player_params": { "health": 2, "jetpack": false }
    }
  },

  "changelog": {
    "v1.0.0": "Initial contract — basic game_mode, entities, physics",
    "v2.0.0": "Added strict required fields, scoring.rules, player_params, contractBuilder enforcement",
    "v3.0.0": "Frozen canonical contract. Added: events_from_execution spec, stripped_fields list, SimEngine integration notes, gameplay_contract requirement in game:started, Mitra mandatory enforcement, no bypass rules"
  }
}
