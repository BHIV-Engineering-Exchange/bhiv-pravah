{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Intent Taxonomy v2.0",
  "description": "Defines supported features and keywords. Maps to engine_contract_schema.json",
  "type": "object",
  "properties": {
    "game_mode": {
      "type": "string",
      "enum": ["runner", "sidescroller"],
      "description": "Core game type",
      "keywords": {
        "runner": ["run", "runner", "endless", "chase", "temple", "sprint"],
        "sidescroller": ["side", "platform", "jump", "scroll", "mario", "platformer"]
      },
      "maps_to": "game_mode"
    },
    "movement": {
      "description": "Player movement parameters",
      "properties": {
        "speed": {
          "type": "number",
          "range": [1, 15],
          "keywords": {
            "fast": ["fast", "quick", "rapid", "speedy", "intense"],
            "slow": ["slow", "sluggish", "careful", "relaxed"],
            "medium": ["medium", "normal", "moderate"]
          },
          "values": {
            "fast": 8,
            "slow": 3,
            "medium": 5
          },
          "maps_to": "movement.speed"
        },
        "jump_height": {
          "type": "number",
          "range": [0, 10],
          "keywords": ["jump", "leap", "hop"],
          "default_value": 5,
          "maps_to": "movement.jump_height"
        }
      }
    },
    "camera": {
      "description": "Camera perspective",
      "properties": {
        "type": {
          "enum": ["third_person", "side_view", "top_down"],
          "auto_detect": {
            "runner": "third_person",
            "sidescroller": "side_view"
          },
          "maps_to": "camera.type"
        },
        "distance": {
          "type": "number",
          "range": [5, 20],
          "default": 10,
          "maps_to": "camera.distance"
        }
      }
    },
    "spawn_rules": {
      "description": "Entity spawning rules",
      "properties": {
        "obstacles": {
          "type": "number",
          "range": [0, 10],
          "keywords": ["obstacle", "avoid", "dodge", "block"],
          "default_value": 2,
          "maps_to": "spawn_rules.obstacles"
        },
        "frequency": {
          "type": "number",
          "range": [0.5, 10],
          "difficulty_mapping": {
            "easy": 3.0,
            "medium": 2.0,
            "hard": 1.5
          },
          "maps_to": "spawn_rules.frequency"
        }
      }
    },
    "score_rules": {
      "description": "Scoring system",
      "properties": {
        "distance": {
          "type": "number",
          "keywords": ["distance", "far", "travel", "run", "score", "point"],
          "default": 1,
          "maps_to": "score_rules.distance"
        },
        "collectibles": {
          "type": "number",
          "keywords": ["collect", "gather", "find", "coin", "pickup", "gem", "retrieve"],
          "default": 10,
          "maps_to": "score_rules.collectibles"
        }
      }
    },
    "end_conditions": {
      "type": "array",
      "enum": ["collision", "time_limit", "distance_goal", "score_goal"],
      "keywords": {
        "collision": ["collision", "hit", "crash"],
        "time_limit": ["time", "timer", "duration"],
        "distance_goal": ["distance", "reach", "goal"],
        "score_goal": ["score", "points", "target"]
      },
      "default": ["collision"],
      "maps_to": "end_conditions"
    },
    "player_params": {
      "description": "Player abilities and stats",
      "properties": {
        "jetpack": {
          "type": "boolean",
          "keywords": ["jetpack", "jet pack", "fly", "flying", "flight", "boost"],
          "default": false,
          "maps_to": "player_params.jetpack"
        },
        "health": {
          "type": "number",
          "range": [1, 100],
          "difficulty_mapping": {
            "easy": 5,
            "medium": 3,
            "hard": 1
          },
          "default": 3,
          "maps_to": "player_params.health"
        }
      }
    },
    "world_params": {
      "description": "World physics and theme",
      "properties": {
        "gravity": {
          "type": "number",
          "default": -9.8,
          "maps_to": "world_params.gravity"
        },
        "theme": {
          "type": "string",
          "enum": ["default", "space", "desert", "forest", "urban"],
          "default": "default",
          "maps_to": "world_params.theme"
        }
      }
    },
    "difficulty": {
      "type": "string",
      "enum": ["easy", "medium", "hard"],
      "keywords": {
        "easy": ["easy", "simple", "beginner", "casual", "peaceful"],
        "medium": ["medium", "moderate", "balanced", "normal"],
        "hard": ["hard", "difficult", "challenging", "complex", "expert", "hardcore"]
      },
      "affects": ["player_params.health", "spawn_rules.frequency"],
      "description": "Affects multiple parameters"
    }
  },
  "examples": [
    {
      "user_input": "Make temple run with jetpack and score",
      "output_contract": {
        "game_mode": "runner",
        "movement": { "speed": 5, "jump_height": 5 },
        "camera": { "type": "third_person", "distance": 10 },
        "spawn_rules": { "obstacles": 0, "frequency": 2 },
        "score_rules": { "distance": 1, "collectibles": 0 },
        "end_conditions": ["collision"],
        "player_params": { "jetpack": true, "health": 3 },
        "world_params": { "gravity": -9.8, "theme": "default" }
      }
    },
    {
      "user_input": "fast runner with obstacles to avoid",
      "output_contract": {
        "game_mode": "runner",
        "movement": { "speed": 8 },
        "camera": { "type": "third_person", "distance": 10 },
        "spawn_rules": { "obstacles": 2, "frequency": 2 },
        "score_rules": { "distance": 1, "collectibles": 0 },
        "end_conditions": ["collision"],
        "player_params": { "jetpack": false, "health": 3 },
        "world_params": { "gravity": -9.8, "theme": "default" }
      }
    },
    {
      "user_input": "platform jump game",
      "output_contract": {
        "game_mode": "sidescroller",
        "movement": { "speed": 5, "jump_height": 5 },
        "camera": { "type": "side_view", "distance": 10 },
        "spawn_rules": { "obstacles": 0, "frequency": 2 },
        "score_rules": { "distance": 1, "collectibles": 0 },
        "end_conditions": ["collision"],
        "player_params": { "jetpack": false, "health": 3 },
        "world_params": { "gravity": -9.8, "theme": "default" }
      }
    }
  ],
  "unsupported_features": {
    "description": "Features not yet implemented",
    "list": [
      {
        "feature": "enemies",
        "keywords": ["enemy", "enemies", "monster", "monsters", "zombie", "zombies", "alien", "aliens"]
      },
      {
        "feature": "weapons",
        "keywords": ["weapon", "weapons", "gun", "guns", "shoot", "shooting", "sword", "swords"]
      },
      {
        "feature": "multiplayer",
        "keywords": ["multiplayer", "multi player", "2 player", "two player", "pvp", "versus"]
      },
      {
        "feature": "powerups",
        "keywords": ["powerup", "power-up", "power up", "buff", "buffs"]
      }
    ]
  }
}
