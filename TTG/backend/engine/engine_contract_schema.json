{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TG Engine Contract v1.0",
  "description": "Simplified game contract for Text-to-Game intent processing",
  "type": "object",
  "required": ["game_mode", "movement", "camera", "spawn_rules", "score_rules", "end_conditions"],
  "additionalProperties": false,
  "properties": {
    "game_mode": {
      "type": "string",
      "enum": ["runner", "sidescroller"],
      "description": "Core game type"
    },
    "movement": {
      "type": "object",
      "required": ["speed"],
      "properties": {
        "speed": {
          "type": "number",
          "minimum": 1,
          "maximum": 15,
          "description": "Player movement speed"
        },
        "jump_height": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Jump force/height"
        }
      }
    },
    "camera": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["third_person", "side_view", "top_down"],
          "description": "Camera perspective"
        },
        "distance": {
          "type": "number",
          "minimum": 5,
          "maximum": 20,
          "default": 10,
          "description": "Camera distance from player"
        }
      }
    },
    "spawn_rules": {
      "type": "object",
      "required": ["obstacles"],
      "properties": {
        "obstacles": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Number of obstacle types"
        },
        "frequency": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 10,
          "default": 2,
          "description": "Spawn frequency in seconds"
        }
      }
    },
    "score_rules": {
      "type": "object",
      "properties": {
        "distance": {
          "type": "number",
          "minimum": 0,
          "default": 1,
          "description": "Points per distance unit"
        },
        "collectibles": {
          "type": "number",
          "minimum": 0,
          "default": 10,
          "description": "Points per collectible"
        }
      }
    },
    "end_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["collision", "time_limit", "distance_goal", "score_goal"]
      },
      "description": "Win/lose conditions"
    },
    "player_params": {
      "type": "object",
      "properties": {
        "jetpack": {
          "type": "boolean",
          "default": false,
          "description": "Enable jetpack ability"
        },
        "health": {
          "type": "number",
          "minimum": 1,
          "maximum": 100,
          "default": 3,
          "description": "Player health/lives"
        }
      }
    },
    "world_params": {
      "type": "object",
      "properties": {
        "gravity": {
          "type": "number",
          "default": -9.8,
          "description": "World gravity"
        },
        "theme": {
          "type": "string",
          "enum": ["default", "space", "desert", "forest", "urban"],
          "default": "default",
          "description": "Visual theme"
        }
      }
    }
  }
}
