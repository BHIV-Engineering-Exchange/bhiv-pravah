      "position": [50, 0, 50], "state": "active",
      "behaviors": ["hold_idle"],
      "meta": { "label": "primary_target" }
    }
  ],

  "behaviors": [
    {
      "id":     "track_target",
      "script": "track",
      "params": {
        "target_id": "surveillance_target",
        "speed":     4.0
      }
    },
    {
      "id":     "hold_idle",
      "script": "idle",
      "params": {}
    }
  ],

  "rules": [
    {
      "id":        "flag_collision",
      "trigger":   "on_collision",
      "condition": { "field": "state", "op": "eq", "value": "active" },
      "action":    { "type": "flag_entity", "params": { "reason": "drone_collision" } },
      "enabled":   true
    },
    {
      "id":        "log_tick",
      "trigger":   "on_tick",
      "condition": { "field": "tick", "op": "eq", "value": 5 },
      "action":    { "type": "emit_event", "params": { "event_type": "midpoint_tick", "data": {} } },
      "enabled":   true
    }
  ]
}
