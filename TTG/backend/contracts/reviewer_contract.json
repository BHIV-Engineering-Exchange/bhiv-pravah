{
  "trace_id":     "trace_reviewer_space_station_001",
  "execution_id": "exec_reviewer_space_station_001",
  "domain":       "space_operations",
  "scenario":     "orbital_station_monitoring",
  "ticks":        12,

  "entities": [
    {
      "id": "station_core", "type": "space_station",
      "position": [0, 0, 0], "state": "operational",
      "behaviors": ["hold_station"],
      "meta": { "designation": "STATION-ALPHA", "crew": 6 }
    },
    {
      "id": "module_alpha", "type": "station_module",
      "position": [10, 0, 0], "state": "operational",
      "behaviors": ["hold_station"],
      "meta": { "function": "life_support" }
    },
    {
      "id": "supply_craft_01", "type": "supply_craft",
      "position": [200, 0, 0], "state": "inbound",
      "behaviors": ["approach_station"],
      "meta": { "cargo": "oxygen_tanks", "fuel_remaining": 80 }
    },
    {
      "id": "supply_craft_02", "type": "supply_craft",
      "position": [0, 200, 0], "state": "inbound",
      "behaviors": ["approach_station"],
      "meta": { "cargo": "food_supplies", "fuel_remaining": 75 }
    },
    {
      "id": "debris_01", "type": "debris",
      "position": [50, 0, 50], "state": "drifting",
      "behaviors": ["drift_path"],
      "meta": { "threat_level": "medium", "size": "small" }
    },
    {
      "id": "debris_02", "type": "debris",
      "position": [-30, 30, 0], "state": "drifting",
      "behaviors": ["drift_path"],
      "meta": { "threat_level": "low", "size": "micro" }
    },
    {
      "id": "docking_zone", "type": "zone",
      "position": [0, 0, 0], "state": "active",
      "behaviors": [],
      "meta": { "radius": 20.0, "label": "Docking Approach Zone" }
    },
    {
      "id": "exclusion_zone", "type": "zone",
      "position": [0, 0, 0], "state": "active",
      "behaviors": [],
      "meta": { "radius": 8.0, "label": "Station Exclusion Zone" }
    }
  ],

  "behaviors": [
    {
      "id": "hold_station", "script": "anchor",
      "params": {}
    },
    {
      "id": "approach_station", "script": "move_to",
      "params": { "target": [0, 0, 0], "speed": 5.0, "threshold": 2.0 }
    },
    {
      "id": "drift_path", "script": "move_to",
      "params": { "target": [0, 0, 0], "speed": 1.5, "threshold": 1.0 }
    }
  ],

  "rules": [
    {
      "id": "flag_debris_proximity",
      "trigger": "on_zone_enter",
      "condition": { "field": "state", "op": "eq", "value": "drifting" },
      "action": { "type": "flag_entity", "params": { "reason": "debris_entered_docking_zone" } },
      "enabled": true
    },
    {
      "id": "supply_craft_docked",
      "trigger": "on_zone_enter",
      "condition": { "field": "state", "op": "eq", "value": "active" },
      "action": { "type": "set_state", "params": { "state": "docking" } },
      "enabled": true
    },
    {
      "id": "alert_exclusion_breach",
      "trigger": "on_zone_enter",
      "condition": { "field": "state", "op": "eq", "value": "drifting" },
      "action": { "type": "block_entity", "params": { "reason": "exclusion_zone_breach_intercepted" } },
      "enabled": true
    },
    {
      "id": "collision_alert",
      "trigger": "on_collision",
      "condition": { "field": "state", "op": "eq", "value": "docking" },
      "action": { "type": "emit_event", "params": { "event_type": "docking_collision_alert", "data": { "severity": "critical" } } },
      "enabled": true
    },
    {
      "id": "mission_status_tick",
      "trigger": "on_tick",
      "condition": { "field": "tick", "op": "eq", "value": 6 },
      "action": { "type": "emit_event", "params": { "event_type": "mission_status_report", "data": {} } },
      "enabled": true
    }
  ]
}
