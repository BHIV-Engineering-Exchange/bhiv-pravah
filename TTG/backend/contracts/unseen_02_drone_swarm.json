{
  "trace_id":     "trace_unseen_02_drone_swarm",
  "execution_id": "exec_unseen_02_drone_swarm",
  "domain":       "surveillance",
  "scenario":     "drone_swarm_formation",
  "ticks":        12,

  "entities": [
    {
      "id": "swarm_lead", "type": "drone",
      "position": [50, 10, 50], "state": "leading",
      "behaviors": ["lead_patrol"],
      "meta": { "role": "lead", "battery": 100 }
    },
    {
      "id": "swarm_01", "type": "drone",
      "position": [0, 8, 0], "state": "following",
      "behaviors": ["track_lead"], "meta": { "role": "follower" }
    },
    {
      "id": "swarm_02", "type": "drone",
      "position": [10, 8, 0], "state": "following",
      "behaviors": ["track_lead"], "meta": { "role": "follower" }
    },
    {
      "id": "swarm_03", "type": "drone",
      "position": [0, 8, 10], "state": "following",
      "behaviors": ["track_lead"], "meta": { "role": "follower" }
    },
    {
      "id": "swarm_04", "type": "drone",
      "position": [20, 8, 0], "state": "following",
      "behaviors": ["track_lead"], "meta": { "role": "follower" }
    },
    {
      "id": "swarm_05", "type": "drone",
      "position": [0, 8, 20], "state": "following",
      "behaviors": ["track_lead"], "meta": { "role": "follower" }
    },
    {
      "id": "surveillance_target", "type": "marker",
      "position": [50, 0, 50], "state": "active",
      "behaviors": ["hold_position"],
      "meta": { "label": "primary_objective" }
    },
    {
      "id": "no_fly_zone", "type": "zone",
      "position": [80, 0, 80], "state": "active",
      "behaviors": [],
      "meta": { "radius": 15.0, "label": "No-Fly Zone" }
    }
  ],

  "behaviors": [
    {
      "id": "lead_patrol", "script": "patrol",
      "params": {
        "waypoints": [[50,10,50],[60,10,60],[70,10,50],[60,10,40],[50,10,50]],
        "speed": 3.0, "threshold": 1.0
      }
    },
    { "id": "track_lead", "script": "track",
      "params": { "target_id": "swarm_lead", "speed": 4.0 }
    },
    { "id": "hold_position", "script": "idle", "params": {} }
  ],

  "rules": [
    {
      "id": "flag_no_fly_entry",
      "trigger": "on_zone_enter",
      "condition": { "field": "state", "op": "eq", "value": "following" },
      "action": { "type": "flag_entity", "params": { "reason": "no_fly_zone_violation" } },
      "enabled": true
    },
    {
      "id": "collision_between_drones",
      "trigger": "on_collision",
      "condition": { "field": "state", "op": "eq", "value": "following" },
      "action": { "type": "emit_event", "params": { "event_type": "swarm_collision_detected", "data": {} } },
      "enabled": true
    },
    {
      "id": "emit_midpoint",
      "trigger": "on_tick",
      "condition": { "field": "tick", "op": "eq", "value": 6 },
      "action": { "type": "emit_event", "params": { "event_type": "swarm_midpoint_check", "data": {} } },
      "enabled": true
    }
  ]
}
