      "id": "stop_intruder_on_flag",
      "trigger": "on_tick",
      "condition": { "field": "state", "op": "eq", "value": "moving", "target": "suspicious_vessel" },
      "action": { "type": "block_entity", "params": { "reason": "intercepted_by_patrol" } },
      "enabled": true
    }
  ]
