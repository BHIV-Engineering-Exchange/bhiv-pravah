{
  "trace_id":     "trace_unseen_03_vehicle_convoy",
  "execution_id": "exec_unseen_03_vehicle_convoy",
  "domain":       "logistics",
  "scenario":     "armoured_convoy",
  "ticks":        15,

  "entities": [
    {
      "id": "convoy_lead", "type": "vehicle",
      "position": [0, 0, 0], "state": "in_transit",
      "behaviors": ["convoy_route"],
      "meta": { "role": "lead", "cargo": "none" }
    },
    {
      "id": "cargo_01", "type": "cargo_vehicle",
      "position": [0, 0, -8], "state": "in_transit",
      "behaviors": ["follow_lead"],
      "meta": { "role": "cargo", "load": "supplies" }
    },
    {
      "id": "cargo_02", "type": "cargo_vehicle",
      "position": [0, 0, -16], "state": "in_transit",
      "behaviors": ["follow_lead"],
      "meta": { "role": "cargo", "load": "equipment" }
    },
    {
      "id": "escort_left", "type": "escort_vehicle",
      "position": [-5, 0, -4], "state": "escorting",
      "behaviors": ["follow_lead"],
      "meta": { "role": "escort", "side": "left" }
    },
    {
      "id": "escort_right", "type": "escort_vehicle",
      "position": [5, 0, -4], "state": "escorting",
      "behaviors": ["follow_lead"],
      "meta": { "role": "escort", "side": "right" }
    },
    {
      "id": "checkpoint_alpha", "type": "zone",
      "position": [40, 0, 0], "state": "active",
      "behaviors": [],
      "meta": { "radius": 6.0, "label": "Checkpoint Alpha" }
    },
    {
      "id": "checkpoint_bravo", "type": "zone",
      "position": [80, 0, 0], "state": "active",
      "behaviors": [],
      "meta": { "radius": 6.0, "label": "Checkpoint Bravo" }
    },
    {
      "id": "destination", "type": "zone",
      "position": [120, 0, 0], "state": "active",
      "behaviors": [],
      "meta": { "radius": 8.0, "label": "Destination" }
    }
  ],

  "behaviors": [
    {
      "id": "convoy_route", "script": "move_to",
      "params": { "target": [120, 0, 0], "speed": 4.0, "threshold": 1.0 }
    },
    {
      "id": "follow_lead", "script": "track",
      "params": { "target_id": "convoy_lead", "speed": 4.5 }
    }
  ],

  "rules": [
    {
      "id": "log_checkpoint_reached",
      "trigger": "on_zone_enter",
      "condition": { "field": "state", "op": "eq", "value": "in_transit", "target": "convoy_lead" },
      "action": { "type": "emit_event", "params": { "event_type": "checkpoint_reached", "data": {} } },
      "enabled": true
    },
    {
      "id": "flag_separation",
      "trigger": "on_tick",
      "condition": { "field": "tick", "op": "gte", "value": 10 },
      "action": { "type": "emit_event", "params": { "event_type": "convoy_tick_update", "data": {} } },
      "enabled": true
    },
    {
      "id": "destination_arrived",
      "trigger": "on_zone_enter",
      "condition": { "field": "state", "op": "eq", "value": "in_transit" },
      "action": { "type": "set_state", "params": { "state": "delivered" } },
      "enabled": true
    }
  ]
}
