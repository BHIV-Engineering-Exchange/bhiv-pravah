{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Consequence Rule Schema",
  "description": "Schema for validating consequence rules",
  "type": "object",
  "required": ["rule_id", "on", "if", "then"],
  "properties": {
    "rule_id": {
      "type": "string",
      "description": "Unique identifier for the rule",
      "pattern": "^[a-z_]+$"
    },
    "on": {
      "type": "string",
      "enum": [
        "collision",
        "entity_spawned",
        "entity_destroyed",
        "score_update",
        "timer_expired",
        "pickup_collected",
        "player_death",
        "level_complete",
        "game_start",
        "game_end",
        "health_changed",
        "position_update"
      ],
      "description": "Event type that triggers this rule"
    },
    "if": {
      "type": "object",
      "required": ["condition"],
      "properties": {
        "condition": {
          "type": "string",
          "description": "Condition name that must be met"
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Required entities involved in the event"
        },
        "context_checks": {
          "type": "object",
          "description": "Additional context checks to validate",
          "additionalProperties": true
        }
      }
    },
    "then": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action", "priority", "payload"],
        "properties": {
          "action": {
            "type": "string",
            "description": "Action to execute"
          },
          "priority": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"],
            "description": "Priority level for action execution"
          },
          "payload": {
            "type": "object",
            "description": "Data to pass to the action",
            "additionalProperties": true
          }
        }
      }
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the rule"
    }
  }
}
