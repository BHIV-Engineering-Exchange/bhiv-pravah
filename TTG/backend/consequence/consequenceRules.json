{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Consequence Rules v1.0",
  "description": "Deterministic rules that map runtime events to engine jobs",
  "version": "1.0.0",
  "rules": [
    {
      "rule_id": "collision_player_obstacle",
      "on": "collision",
      "if": {
        "condition": "player_hits_obstacle",
        "entities": ["player", "obstacle"],
        "context_checks": {
          "entity_type": "obstacle"
        }
      },
      "then": [
        {
          "action": "END_GAME",
          "priority": "critical",
          "payload": {
            "reason": "collision_with_obstacle",
            "show_game_over": true
          }
        }
      ],
      "description": "End game when player collides with obstacle"
    },
    {
      "rule_id": "collision_player_enemy",
      "on": "collision",
      "if": {
        "condition": "player_hits_enemy",
        "entities": ["player", "enemy"],
        "context_checks": {
          "entity_type": "enemy"
        }
      },
      "then": [
        {
          "action": "DAMAGE_PLAYER",
          "priority": "high",
          "payload": {
            "damage": 1
          }
        },
        {
          "action": "CHECK_PLAYER_HEALTH",
          "priority": "high",
          "payload": {}
        }
      ],
      "description": "Damage player when colliding with enemy"
    },
    {
      "rule_id": "collision_player_wall",
      "on": "collision",
      "if": {
        "condition": "player_hits_wall",
        "entities": ["player", "wall"],
        "context_checks": {
          "entity_type": "platform"
        }
      },
      "then": [
        {
          "action": "STOP_MOVEMENT",
          "priority": "medium",
          "payload": {
            "axis": "x"
          }
        }
      ],
      "description": "Stop player movement when hitting wall"
    },
    {
      "rule_id": "enemy_killed",
      "on": "entity_destroyed",
      "if": {
        "condition": "enemy_killed",
        "context_checks": {
          "entity_type": "enemy"
        }
      },
      "then": [
        {
          "action": "UPDATE_SCORE",
          "priority": "medium",
          "payload": {
            "score_delta": 100,
            "reason": "enemy_killed"
          }
        },
        {
          "action": "SPAWN_ENTITY",
          "priority": "low",
          "payload": {
            "entity_type": "enemy",
            "delay": 2000
          }
        },
        {
          "action": "PLAY_SOUND",
          "priority": "low",
          "payload": {
            "sound_id": "enemy_death"
          }
        }
      ],
      "description": "Award points and spawn new enemy when enemy is killed"
    },
    {
      "rule_id": "enemy_killed_wave_clear",
      "on": "entity_destroyed",
      "if": {
        "condition": "last_enemy_killed",
        "context_checks": {
          "entity_type": "enemy"
        },
        "state_checks": {
          "entities.enemy_count": { "operator": "==", "value": 0 }
        }
      },
      "then": [
        {
          "action": "SPAWN_NEXT_WAVE",
          "priority": "high",
          "payload": {
            "wave_size": 5,
            "delay": 3000,
            "reason": "wave_cleared"
          }
        },
        {
          "action": "UPDATE_SCORE",
          "priority": "medium",
          "payload": {
            "score_delta": 500,
            "reason": "wave_cleared_bonus"
          }
        },
        {
          "action": "PLAY_SOUND",
          "priority": "low",
          "payload": {
            "sound_id": "wave_clear"
          }
        }
      ],
      "description": "Spawn next wave when all enemies are killed (enemy_count == 0)"
    },
    {
      "rule_id": "pickup_collected_coin",
      "on": "pickup_collected",
      "if": {
        "condition": "coin_collected",
        "context_checks": {
          "entity_type": "collectible"
        }
      },
      "then": [
        {
          "action": "UPDATE_SCORE",
          "priority": "medium",
          "payload": {
            "score_delta": 10,
            "reason": "coin_collected"
          }
        },
        {
          "action": "PLAY_SOUND",
          "priority": "low",
          "payload": {
            "sound_id": "coin_pickup"
          }
        },
        {
          "action": "SPAWN_ENTITY",
          "priority": "low",
          "payload": {
            "entity_type": "collectible",
            "delay": 1000
          }
        }
      ],
      "description": "Award points and play sound when coin is collected"
    },
    {
      "rule_id": "pickup_collected_powerup",
      "on": "pickup_collected",
      "if": {
        "condition": "powerup_collected",
        "context_checks": {
          "entity_type": "collectible"
        }
      },
      "then": [
        {
          "action": "APPLY_POWERUP",
          "priority": "high",
          "payload": {
            "powerup_type": "speed_boost",
            "duration": 5000
          }
        },
        {
          "action": "UPDATE_SCORE",
          "priority": "medium",
          "payload": {
            "score_delta": 50,
            "reason": "powerup_collected"
          }
        }
      ],
      "description": "Apply powerup effect when collected"
    },
    {
      "rule_id": "timer_expired_game_over",
      "on": "timer_expired",
      "if": {
        "condition": "game_timer_expired",
        "context_checks": {
          "timer_value": 0
        }
      },
      "then": [
        {
          "action": "END_GAME",
          "priority": "critical",
          "payload": {
            "reason": "time_up",
            "show_game_over": true,
            "show_final_score": true
          }
        }
      ],
      "description": "End game when timer reaches zero"
    },
    {
      "rule_id": "timer_expired_round_end",
      "on": "timer_expired",
      "if": {
        "condition": "round_timer_expired",
        "context_checks": {
          "timer_value": 0
        }
      },
      "then": [
        {
          "action": "END_ROUND",
          "priority": "high",
          "payload": {
            "show_results": true
          }
        },
        {
          "action": "START_NEXT_ROUND",
          "priority": "medium",
          "payload": {
            "delay": 3000
          }
        }
      ],
      "description": "End current round and start next when round timer expires"
    },
    {
      "rule_id": "player_death",
      "on": "player_death",
      "if": {
        "condition": "player_died",
        "entities": ["player"]
      },
      "then": [
        {
          "action": "DECREMENT_LIVES",
          "priority": "critical",
          "payload": {}
        },
        {
          "action": "CHECK_GAME_OVER",
          "priority": "critical",
          "payload": {}
        },
        {
          "action": "RESPAWN_PLAYER",
          "priority": "high",
          "payload": {
            "delay": 2000,
            "invincibility_duration": 3000
          }
        }
      ],
      "description": "Handle player death, check lives, and respawn"
    },
    {
      "rule_id": "player_death_game_over",
      "on": "player_death",
      "if": {
        "condition": "player_died_no_lives",
        "entities": ["player"],
        "state_checks": {
          "player.lives": { "operator": "<=", "value": 0 }
        }
      },
      "then": [
        {
          "action": "END_GAME",
          "priority": "critical",
          "payload": {
            "reason": "no_lives_remaining",
            "show_game_over": true,
            "show_final_score": true
          }
        }
      ],
      "description": "End game when player dies with no lives remaining (lives <= 0)"
    },
    {
      "rule_id": "score_milestone",
      "on": "score_update",
      "if": {
        "condition": "score_milestone_reached",
        "context_checks": {
          "score": {
            "operator": ">=",
            "value": 1000
          }
        }
      },
      "then": [
        {
          "action": "INCREASE_DIFFICULTY",
          "priority": "medium",
          "payload": {
            "difficulty_level": 2
          }
        },
        {
          "action": "PLAY_SOUND",
          "priority": "low",
          "payload": {
            "sound_id": "milestone_reached"
          }
        }
      ],
      "description": "Increase difficulty when score milestone is reached"
    },
    {
      "rule_id": "low_health_warning",
      "on": "health_changed",
      "if": {
        "condition": "player_low_health",
        "state_checks": {
          "player.health": { "operator": "<=", "value": 1 },
          "player.is_alive": true
        }
      },
      "then": [
        {
          "action": "PLAY_SOUND",
          "priority": "high",
          "payload": {
            "sound_id": "low_health_warning"
          }
        },
        {
          "action": "SPAWN_ENTITY",
          "priority": "medium",
          "payload": {
            "entity_type": "collectible",
            "subtype": "health_pack",
            "delay": 1000
          }
        }
      ],
      "description": "Warn player and spawn health pack when health drops to 1"
    },
    {
      "rule_id": "high_score_difficulty_boost",
      "on": "score_update",
      "if": {
        "condition": "high_score_difficulty_boost",
        "state_checks": {
          "player.score": { "operator": ">=", "value": 500 },
          "world.difficulty": { "operator": "<", "value": 3 }
        }
      },
      "then": [
        {
          "action": "INCREASE_DIFFICULTY",
          "priority": "medium",
          "payload": {
            "difficulty_level": 3,
            "reason": "score_threshold_reached"
          }
        }
      ],
      "description": "Boost difficulty to level 3 when score >= 500 and difficulty is still below 3"
    },
    {
      "rule_id": "level_complete",
      "on": "level_complete",
      "if": {
        "condition": "all_objectives_complete"
      },
      "then": [
        {
          "action": "CALCULATE_BONUS",
          "priority": "high",
          "payload": {}
        },
        {
          "action": "SHOW_LEVEL_COMPLETE",
          "priority": "high",
          "payload": {
            "show_stats": true
          }
        },
        {
          "action": "LOAD_NEXT_LEVEL",
          "priority": "medium",
          "payload": {
            "delay": 5000
          }
        }
      ],
      "description": "Handle level completion and load next level"
    },
    {
      "rule_id": "health_depleted",
      "on": "health_changed",
      "if": {
        "condition": "health_zero",
        "context_checks": {
          "health": {
            "operator": "<=",
            "value": 0
          }
        }
      },
      "then": [
        {
          "action": "TRIGGER_PLAYER_DEATH",
          "priority": "critical",
          "payload": {}
        }
      ],
      "description": "Trigger player death when health reaches zero"
    },
    {
      "rule_id": "entity_spawned_enemy",
      "on": "entity_spawned",
      "if": {
        "condition": "enemy_spawned",
        "context_checks": {
          "entity_type": "enemy"
        }
      },
      "then": [
        {
          "action": "SET_ENEMY_BEHAVIOR",
          "priority": "medium",
          "payload": {
            "behavior": "patrol",
            "speed": 2.0
          }
        },
        {
          "action": "PLAY_SOUND",
          "priority": "low",
          "payload": {
            "sound_id": "enemy_spawn"
          }
        }
      ],
      "description": "Initialize enemy behavior when spawned"
    }
  ],
  "action_definitions": {
    "END_GAME": {
      "description": "Terminate the game session",
      "job_type": "END_GAME",
      "required_payload": ["reason"],
      "optional_payload": ["show_game_over", "show_final_score"]
    },
    "UPDATE_SCORE": {
      "description": "Update player score",
      "job_type": "UPDATE_SCORE",
      "required_payload": ["score_delta"],
      "optional_payload": ["reason"]
    },
    "SPAWN_ENTITY": {
      "description": "Spawn a new entity in the game",
      "job_type": "SPAWN_ENTITY",
      "required_payload": ["entity_type"],
      "optional_payload": ["delay", "position"]
    },
    "DAMAGE_PLAYER": {
      "description": "Apply damage to player",
      "job_type": "DAMAGE_PLAYER",
      "required_payload": ["damage"],
      "optional_payload": []
    },
    "CHECK_PLAYER_HEALTH": {
      "description": "Check if player health is depleted",
      "job_type": "CHECK_PLAYER_HEALTH",
      "required_payload": [],
      "optional_payload": []
    },
    "STOP_MOVEMENT": {
      "description": "Stop entity movement",
      "job_type": "STOP_MOVEMENT",
      "required_payload": [],
      "optional_payload": ["axis"]
    },
    "PLAY_SOUND": {
      "description": "Play a sound effect",
      "job_type": "PLAY_SOUND",
      "required_payload": ["sound_id"],
      "optional_payload": []
    },
    "END_ROUND": {
      "description": "End the current round",
      "job_type": "END_ROUND",
      "required_payload": [],
      "optional_payload": ["show_results"]
    },
    "START_NEXT_ROUND": {
      "description": "Start the next round",
      "job_type": "START_NEXT_ROUND",
      "required_payload": [],
      "optional_payload": ["delay"]
    },
    "DECREMENT_LIVES": {
      "description": "Decrease player lives by 1",
      "job_type": "DECREMENT_LIVES",
      "required_payload": [],
      "optional_payload": []
    },
    "CHECK_GAME_OVER": {
      "description": "Check if game should end (no lives left)",
      "job_type": "CHECK_GAME_OVER",
      "required_payload": [],
      "optional_payload": []
    },
    "RESPAWN_PLAYER": {
      "description": "Respawn player at checkpoint",
      "job_type": "RESPAWN_PLAYER",
      "required_payload": [],
      "optional_payload": ["delay", "invincibility_duration"]
    },
    "APPLY_POWERUP": {
      "description": "Apply powerup effect to player",
      "job_type": "APPLY_POWERUP",
      "required_payload": ["powerup_type"],
      "optional_payload": ["duration"]
    },
    "INCREASE_DIFFICULTY": {
      "description": "Increase game difficulty",
      "job_type": "INCREASE_DIFFICULTY",
      "required_payload": ["difficulty_level"],
      "optional_payload": []
    },
    "CALCULATE_BONUS": {
      "description": "Calculate level completion bonus",
      "job_type": "CALCULATE_BONUS",
      "required_payload": [],
      "optional_payload": []
    },
    "SHOW_LEVEL_COMPLETE": {
      "description": "Display level complete screen",
      "job_type": "SHOW_LEVEL_COMPLETE",
      "required_payload": [],
      "optional_payload": ["show_stats"]
    },
    "LOAD_NEXT_LEVEL": {
      "description": "Load the next level",
      "job_type": "LOAD_NEXT_LEVEL",
      "required_payload": [],
      "optional_payload": ["delay"]
    },
    "TRIGGER_PLAYER_DEATH": {
      "description": "Trigger player death event",
      "job_type": "TRIGGER_PLAYER_DEATH",
      "required_payload": [],
      "optional_payload": []
    },
    "SPAWN_NEXT_WAVE": {
      "description": "Spawn the next enemy wave after wave clear",
      "job_type": "SPAWN_NEXT_WAVE",
      "required_payload": ["wave_size"],
      "optional_payload": ["delay", "reason"]
    },
    "SET_ENEMY_BEHAVIOR": {
      "description": "Set enemy AI behavior",
      "job_type": "SET_ENEMY_BEHAVIOR",
      "required_payload": ["behavior"],
      "optional_payload": ["speed"]
    }
  },
  "priority_levels": {
    "critical": {
      "value": 1,
      "description": "Must be processed immediately, cannot be delayed"
    },
    "high": {
      "value": 2,
      "description": "Should be processed quickly, minimal delay acceptable"
    },
    "medium": {
      "value": 3,
      "description": "Normal priority, can be queued"
    },
    "low": {
      "value": 4,
      "description": "Can be delayed or batched"
    }
  },
  "metadata": {
    "created": "2025-01-10",
    "version": "1.0.0",
    "author": "Rudra",
    "description": "Deterministic consequence rules for gameplay events"
  }
}
