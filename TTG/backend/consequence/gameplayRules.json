{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gameplay Rules Library v1.0",
  "description": "Reusable gameplay consequence rules organized by game mode",
  "version": "1.0.0",
  "game_modes": {
    "runner": {
      "name": "Runner Game",
      "description": "Endless runner with obstacles and collectibles",
      "rules": [
        {
          "rule_id": "runner_collision_obstacle",
          "on": "collision",
          "if": {
            "condition": "player_hits_obstacle",
            "entities": ["player", "obstacle"],
            "context_checks": {
              "entity_type": "obstacle"
            }
          },
          "then": [
            {
              "action": "END_GAME",
              "priority": "critical",
              "payload": {
                "reason": "collision_with_obstacle",
                "show_game_over": true,
                "show_final_score": true
              }
            },
            {
              "action": "PLAY_SOUND",
              "priority": "low",
              "payload": {
                "sound_id": "game_over"
              }
            }
          ],
          "description": "End game when player hits obstacle"
        },
        {
          "rule_id": "runner_pickup_coin",
          "on": "pickup_collected",
          "if": {
            "condition": "coin_collected",
            "context_checks": {
              "entity_type": "collectible"
            }
          },
          "then": [
            {
              "action": "UPDATE_SCORE",
              "priority": "medium",
              "payload": {
                "score_delta": 10,
                "reason": "coin_collected"
              }
            },
            {
              "action": "PLAY_SOUND",
              "priority": "low",
              "payload": {
                "sound_id": "coin_pickup"
              }
            }
          ],
          "description": "Award points when coin collected"
        },
        {
          "rule_id": "runner_distance_milestone",
          "on": "score_update",
          "if": {
            "condition": "distance_milestone",
            "context_checks": {
              "score": {
                "operator": ">=",
                "value": 1000
              }
            }
          },
          "then": [
            {
              "action": "INCREASE_DIFFICULTY",
              "priority": "medium",
              "payload": {
                "difficulty_level": 2,
                "speed_multiplier": 1.2
              }
            },
            {
              "action": "PLAY_SOUND",
              "priority": "low",
              "payload": {
                "sound_id": "milestone"
              }
            }
          ],
          "description": "Increase difficulty at score milestones"
        },
        {
          "rule_id": "runner_timer_expired",
          "on": "timer_expired",
          "if": {
            "condition": "game_timer_expired",
            "context_checks": {
              "timer_value": 0
            }
          },
          "then": [
            {
              "action": "END_GAME",
              "priority": "critical",
              "payload": {
                "reason": "time_up",
                "show_game_over": true,
                "show_final_score": true
              }
            }
          ],
          "description": "End game when time runs out"
        }
      ]
    },
    "arena": {
      "name": "Arena Game",
      "description": "Combat arena with enemies and power-ups",
      "rules": [
        {
          "rule_id": "arena_enemy_killed",
          "on": "entity_destroyed",
          "if": {
            "condition": "enemy_killed",
            "context_checks": {
              "entity_type": "enemy"
            }
          },
          "then": [
            {
              "action": "UPDATE_SCORE",
              "priority": "medium",
              "payload": {
                "score_delta": 100,
                "reason": "enemy_killed"
              }
            },
            {
              "action": "SPAWN_ENTITY",
              "priority": "low",
              "payload": {
                "entity_type": "enemy",
                "delay": 3000,
                "spawn_location": "random"
              }
            },
            {
              "action": "PLAY_SOUND",
              "priority": "low",
              "payload": {
                "sound_id": "enemy_death"
              }
            }
          ],
          "description": "Award points and spawn new enemy when enemy killed"
        },
        {
          "rule_id": "arena_player_hit",
          "on": "collision",
          "if": {
            "condition": "player_hit_by_enemy",
            "entities": ["player", "enemy"],
            "context_checks": {
              "entity_type": "enemy"
            }
          },
          "then": [
            {
              "action": "DAMAGE_PLAYER",
              "priority": "high",
              "payload": {
                "damage": 1
              }
            },
            {
              "action": "CHECK_PLAYER_HEALTH",
              "priority": "high",
              "payload": {}
            },
            {
              "action": "PLAY_SOUND",
              "priority": "low",
              "payload": {
                "sound_id": "player_hit"
              }
            }
          ],
          "description": "Damage player when hit by enemy"
        },
        {
          "rule_id": "arena_health_depleted",
          "on": "health_changed",
          "if": {
            "condition": "health_zero",
            "context_checks": {
              "health": {
                "operator": "<=",
                "value": 0
              }
            }
          },
          "then": [
            {
              "action": "TRIGGER_PLAYER_DEATH",
              "priority": "critical",
              "payload": {}
            }
          ],
          "description": "Trigger death when health reaches zero"
        },
        {
          "rule_id": "arena_player_death",
          "on": "player_death",
          "if": {
            "condition": "player_died",
            "entities": ["player"]
          },
          "then": [
            {
              "action": "DECREMENT_LIVES",
              "priority": "critical",
              "payload": {}
            },
            {
              "action": "CHECK_GAME_OVER",
              "priority": "critical",
              "payload": {}
            },
            {
              "action": "RESPAWN_PLAYER",
              "priority": "high",
              "payload": {
                "delay": 2000,
                "invincibility_duration": 3000
              }
            }
          ],
          "description": "Handle player death and respawn"
        },
        {
          "rule_id": "arena_powerup_collected",
          "on": "pickup_collected",
          "if": {
            "condition": "powerup_collected",
            "context_checks": {
              "entity_type": "collectible"
            }
          },
          "then": [
            {
              "action": "APPLY_POWERUP",
              "priority": "high",
              "payload": {
                "powerup_type": "damage_boost",
                "duration": 10000
              }
            },
            {
              "action": "UPDATE_SCORE",
              "priority": "medium",
              "payload": {
                "score_delta": 50,
                "reason": "powerup_collected"
              }
            },
            {
              "action": "PLAY_SOUND",
              "priority": "low",
              "payload": {
                "sound_id": "powerup"
              }
            }
          ],
          "description": "Apply powerup effect when collected"
        },
        {
          "rule_id": "arena_wave_complete",
          "on": "score_update",
          "if": {
            "condition": "wave_complete",
            "context_checks": {
              "enemies_remaining": 0
            }
          },
          "then": [
            {
              "action": "START_NEXT_WAVE",
              "priority": "high",
              "payload": {
                "wave_number": 2,
                "enemy_count": 5
              }
            },
            {
              "action": "SPAWN_HEALTH_PACK",
              "priority": "medium",
              "payload": {}
            }
          ],
          "description": "Start next wave when all enemies defeated"
        }
      ]
    },
    "platformer": {
      "name": "Platform Game",
      "description": "Side-scrolling platformer with jumping and collectibles",
      "rules": [
        {
          "rule_id": "platformer_pickup_collected",
          "on": "pickup_collected",
          "if": {
            "condition": "coin_collected",
            "context_checks": {
              "entity_type": "collectible"
            }
          },
          "then": [
            {
              "action": "UPDATE_SCORE",
              "priority": "medium",
              "payload": {
                "score_delta": 10,
                "reason": "coin_collected"
              }
            },
            {
              "action": "SPAWN_ENTITY",
              "priority": "low",
              "payload": {
                "entity_type": "collectible",
                "delay": 5000,
                "spawn_location": "next_platform"
              }
            },
            {
              "action": "PLAY_SOUND",
              "priority": "low",
              "payload": {
                "sound_id": "coin_pickup"
              }
            }
          ],
          "description": "Award points and spawn next collectible"
        },
        {
          "rule_id": "platformer_fall_death",
          "on": "position_update",
          "if": {
            "condition": "player_fell_off",
            "context_checks": {
              "position": {
                "y": {
                  "operator": "<",
                  "value": -10
                }
              }
            }
          },
          "then": [
            {
              "action": "TRIGGER_PLAYER_DEATH",
              "priority": "critical",
              "payload": {
                "reason": "fell_off_map"
              }
            }
          ],
          "description": "Kill player if they fall off the map"
        },
        {
          "rule_id": "platformer_enemy_stomp",
          "on": "collision",
          "if": {
            "condition": "player_stomps_enemy",
            "entities": ["player", "enemy"],
            "context_checks": {
              "entity_type": "enemy",
              "collision_type": "from_above"
            }
          },
          "then": [
            {
              "action": "DESTROY_ENTITY",
              "priority": "high",
              "payload": {
                "entity_id": "enemy"
              }
            },
            {
              "action": "UPDATE_SCORE",
              "priority": "medium",
              "payload": {
                "score_delta": 50,
                "reason": "enemy_stomped"
              }
            },
            {
              "action": "PLAYER_BOUNCE",
              "priority": "high",
              "payload": {
                "bounce_force": 5
              }
            }
          ],
          "description": "Destroy enemy and bounce player when stomped"
        },
        {
          "rule_id": "platformer_enemy_collision",
          "on": "collision",
          "if": {
            "condition": "player_hits_enemy_side",
            "entities": ["player", "enemy"],
            "context_checks": {
              "entity_type": "enemy",
              "collision_type": "from_side"
            }
          },
          "then": [
            {
              "action": "DAMAGE_PLAYER",
              "priority": "high",
              "payload": {
                "damage": 1
              }
            },
            {
              "action": "KNOCKBACK_PLAYER",
              "priority": "high",
              "payload": {
                "force": 3
              }
            },
            {
              "action": "CHECK_PLAYER_HEALTH",
              "priority": "high",
              "payload": {}
            }
          ],
          "description": "Damage and knockback player when hit from side"
        },
        {
          "rule_id": "platformer_checkpoint_reached",
          "on": "entity_spawned",
          "if": {
            "condition": "checkpoint_activated",
            "context_checks": {
              "entity_type": "checkpoint"
            }
          },
          "then": [
            {
              "action": "SAVE_CHECKPOINT",
              "priority": "high",
              "payload": {
                "checkpoint_id": "checkpoint_1"
              }
            },
            {
              "action": "PLAY_SOUND",
              "priority": "low",
              "payload": {
                "sound_id": "checkpoint"
              }
            }
          ],
          "description": "Save progress at checkpoint"
        },
        {
          "rule_id": "platformer_level_complete",
          "on": "level_complete",
          "if": {
            "condition": "reached_goal",
            "context_checks": {
              "goal_reached": true
            }
          },
          "then": [
            {
              "action": "CALCULATE_BONUS",
              "priority": "high",
              "payload": {
                "time_bonus": true,
                "coin_bonus": true
              }
            },
            {
              "action": "SHOW_LEVEL_COMPLETE",
              "priority": "high",
              "payload": {
                "show_stats": true
              }
            },
            {
              "action": "LOAD_NEXT_LEVEL",
              "priority": "medium",
              "payload": {
                "delay": 5000
              }
            }
          ],
          "description": "Complete level and load next"
        }
      ]
    },
    "puzzle": {
      "name": "Puzzle Game",
      "description": "Match-3 or tile-based puzzle game",
      "rules": [
        {
          "rule_id": "puzzle_match_made",
          "on": "entity_destroyed",
          "if": {
            "condition": "tiles_matched",
            "context_checks": {
              "entity_type": "tile",
              "match_count": {
                "operator": ">=",
                "value": 3
              }
            }
          },
          "then": [
            {
              "action": "UPDATE_SCORE",
              "priority": "medium",
              "payload": {
                "score_delta": 30,
                "reason": "tiles_matched"
              }
            },
            {
              "action": "SPAWN_NEW_TILES",
              "priority": "medium",
              "payload": {
                "count": 3
              }
            },
            {
              "action": "PLAY_SOUND",
              "priority": "low",
              "payload": {
                "sound_id": "match"
              }
            }
          ],
          "description": "Award points and spawn new tiles on match"
        },
        {
          "rule_id": "puzzle_combo",
          "on": "score_update",
          "if": {
            "condition": "combo_active",
            "context_checks": {
              "combo_count": {
                "operator": ">=",
                "value": 3
              }
            }
          },
          "then": [
            {
              "action": "APPLY_COMBO_MULTIPLIER",
              "priority": "high",
              "payload": {
                "multiplier": 2
              }
            },
            {
              "action": "PLAY_SOUND",
              "priority": "low",
              "payload": {
                "sound_id": "combo"
              }
            }
          ],
          "description": "Apply score multiplier for combos"
        },
        {
          "rule_id": "puzzle_moves_depleted",
          "on": "score_update",
          "if": {
            "condition": "no_moves_left",
            "context_checks": {
              "moves_remaining": 0
            }
          },
          "then": [
            {
              "action": "END_GAME",
              "priority": "critical",
              "payload": {
                "reason": "no_moves",
                "show_game_over": true,
                "show_final_score": true
              }
            }
          ],
          "description": "End game when no moves remaining"
        }
      ]
    },
    "racing": {
      "name": "Racing Game",
      "description": "Racing game with checkpoints and opponents",
      "rules": [
        {
          "rule_id": "racing_checkpoint_passed",
          "on": "entity_spawned",
          "if": {
            "condition": "checkpoint_passed",
            "context_checks": {
              "entity_type": "checkpoint"
            }
          },
          "then": [
            {
              "action": "UPDATE_LAP_PROGRESS",
              "priority": "high",
              "payload": {
                "checkpoint_number": 1
              }
            },
            {
              "action": "PLAY_SOUND",
              "priority": "low",
              "payload": {
                "sound_id": "checkpoint"
              }
            }
          ],
          "description": "Update progress when checkpoint passed"
        },
        {
          "rule_id": "racing_lap_complete",
          "on": "level_complete",
          "if": {
            "condition": "lap_finished",
            "context_checks": {
              "lap_complete": true
            }
          },
          "then": [
            {
              "action": "INCREMENT_LAP",
              "priority": "high",
              "payload": {}
            },
            {
              "action": "CHECK_RACE_COMPLETE",
              "priority": "high",
              "payload": {
                "total_laps": 3
              }
            }
          ],
          "description": "Complete lap and check if race finished"
        },
        {
          "rule_id": "racing_collision_wall",
          "on": "collision",
          "if": {
            "condition": "hit_wall",
            "entities": ["player", "wall"],
            "context_checks": {
              "entity_type": "wall"
            }
          },
          "then": [
            {
              "action": "SLOW_DOWN_PLAYER",
              "priority": "high",
              "payload": {
                "speed_reduction": 0.5
              }
            },
            {
              "action": "PLAY_SOUND",
              "priority": "low",
              "payload": {
                "sound_id": "crash"
              }
            }
          ],
          "description": "Slow down player when hitting wall"
        }
      ]
    }
  },
  "common_rules": {
    "description": "Rules that apply across multiple game modes",
    "rules": [
      {
        "rule_id": "common_pause_game",
        "on": "game_start",
        "if": {
          "condition": "pause_requested"
        },
        "then": [
          {
            "action": "PAUSE_GAME",
            "priority": "critical",
            "payload": {}
          }
        ],
        "description": "Pause game when requested"
      },
      {
        "rule_id": "common_resume_game",
        "on": "game_start",
        "if": {
          "condition": "resume_requested"
        },
        "then": [
          {
            "action": "RESUME_GAME",
            "priority": "critical",
            "payload": {}
          }
        ],
        "description": "Resume game when requested"
      }
    ]
  },
  "metadata": {
    "created": "2025-01-10",
    "version": "1.0.0",
    "author": "Rudra",
    "description": "Reusable gameplay consequence rules organized by game mode",
    "total_game_modes": 5,
    "total_rules": 28
  }
}
