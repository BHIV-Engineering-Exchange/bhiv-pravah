{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rule Contract Schema",
  "description": "Deterministic gameplay consequence rules for TG Engine",
  "type": "object",
  "required": ["rule_id", "trigger", "condition", "consequence"],
  "properties": {
    "rule_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Unique identifier for the rule"
    },
    "trigger": {
      "type": "string",
      "enum": [
        "collision",
        "timeout",
        "property_change",
        "distance_reached",
        "score_reached",
        "entity_spawned",
        "entity_destroyed",
        "input_event",
        "game_start",
        "game_end"
      ],
      "description": "Event type that activates this rule"
    },
    "condition": {
      "oneOf": [
        {
          "type": "string",
          "description": "Simple condition expression"
        },
        {
          "type": "object",
          "description": "Complex condition with parameters",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "entity_collision",
                "property_threshold",
                "time_elapsed",
                "distance_traveled",
                "score_threshold",
                "entity_count",
                "custom_expression"
              ]
            },
            "entities": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Entity types or IDs involved"
            },
            "property": {
              "type": "string",
              "description": "Property name to check"
            },
            "operator": {
              "type": "string",
              "enum": ["==", "!=", ">", "<", ">=", "<="],
              "description": "Comparison operator"
            },
            "value": {
              "description": "Value to compare against"
            },
            "expression": {
              "type": "string",
              "description": "Custom boolean expression"
            }
          }
        }
      ]
    },
    "consequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "description": "Simple action name"
          },
          {
            "type": "object",
            "description": "Action with parameters",
            "required": ["action"],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "emit_event",
                  "emit_game_over",
                  "emit_game_win",
                  "update_property",
                  "reduce_health",
                  "increase_score",
                  "spawn_entity",
                  "destroy_entity",
                  "play_sound",
                  "show_message",
                  "pause_game",
                  "resume_game",
                  "restart_game",
                  "change_state"
                ]
              },
              "target": {
                "type": "string",
                "description": "Target entity ID or type"
              },
              "property": {
                "type": "string",
                "description": "Property to modify"
              },
              "value": {
                "description": "Value to set or change by"
              },
              "amount": {
                "type": "number",
                "description": "Amount to change by"
              },
              "event": {
                "type": "string",
                "description": "Event name to emit"
              },
              "data": {
                "type": "object",
                "description": "Additional event data"
              },
              "condition": {
                "type": "string",
                "description": "Optional condition for this consequence"
              }
            }
          }
        ]
      },
      "description": "Array of actions to execute when rule triggers"
    },
    "priority": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 50,
      "description": "Rule execution priority (higher = earlier)"
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether this rule is active"
    },
    "cooldown_ms": {
      "type": "number",
      "minimum": 0,
      "description": "Minimum time between rule activations in milliseconds"
    },
    "max_triggers": {
      "type": "number",
      "minimum": 1,
      "description": "Maximum number of times this rule can trigger"
    },
    "metadata": {
      "type": "object",
      "description": "Additional rule metadata",
      "properties": {
        "description": { "type": "string" },
        "category": { "type": "string" },
        "author": { "type": "string" },
        "version": { "type": "string" }
      }
    }
  }
}
