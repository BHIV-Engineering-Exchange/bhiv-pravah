[
  {
    "rule_id": "player_collision_obstacle",
    "trigger": "collision",
    "condition": {
      "type": "entity_collision",
      "entities": ["player", "obstacle"]
    },
    "consequence": [
      {
        "action": "reduce_health",
        "target": "player",
        "amount": 1
      },
      {
        "action": "emit_event",
        "event": "player_hit",
        "data": {
          "damage": 1,
          "source": "obstacle"
        }
      },
      {
        "action": "emit_game_over",
        "condition": "health <= 0"
      }
    ],
    "priority": 90,
    "enabled": true,
    "metadata": {
      "description": "Player loses health when hitting obstacle, game over if health reaches 0",
      "category": "collision"
    }
  },
  {
    "rule_id": "player_collect_coin",
    "trigger": "collision",
    "condition": {
      "type": "entity_collision",
      "entities": ["player", "collectible"]
    },
    "consequence": [
      {
        "action": "increase_score",
        "target": "player",
        "amount": 10
      },
      {
        "action": "destroy_entity",
        "target": "collectible"
      },
      {
        "action": "play_sound",
        "value": "coin_collect"
      }
    ],
    "priority": 80,
    "enabled": true,
    "metadata": {
      "description": "Player collects coin, gains 10 points, coin disappears",
      "category": "collectible"
    }
  },
  {
    "rule_id": "game_timeout",
    "trigger": "timeout",
    "condition": {
      "type": "time_elapsed",
      "operator": ">=",
      "value": 60000
    },
    "consequence": [
      {
        "action": "emit_event",
        "event": "time_limit_reached"
      },
      {
        "action": "emit_game_over",
        "data": {
          "reason": "time_limit"
        }
      }
    ],
    "priority": 100,
    "enabled": true,
    "max_triggers": 1,
    "metadata": {
      "description": "Game ends after 60 seconds",
      "category": "time_limit"
    }
  },
  {
    "rule_id": "distance_milestone",
    "trigger": "distance_reached",
    "condition": {
      "type": "distance_traveled",
      "operator": ">=",
      "value": 100
    },
    "consequence": [
      {
        "action": "show_message",
        "value": "100m milestone reached!"
      },
      {
        "action": "increase_score",
        "amount": 50
      }
    ],
    "priority": 50,
    "enabled": true,
    "cooldown_ms": 5000,
    "metadata": {
      "description": "Bonus points every 100m traveled",
      "category": "milestone"
    }
  },
  {
    "rule_id": "low_health_warning",
    "trigger": "property_change",
    "condition": {
      "type": "property_threshold",
      "entities": ["player"],
      "property": "health",
      "operator": "<=",
      "value": 1
    },
    "consequence": [
      {
        "action": "emit_event",
        "event": "low_health_warning"
      },
      {
        "action": "show_message",
        "value": "Warning: Low health!"
      }
    ],
    "priority": 70,
    "enabled": true,
    "cooldown_ms": 3000,
    "metadata": {
      "description": "Warn player when health is critically low",
      "category": "warning"
    }
  },
  {
    "rule_id": "score_victory",
    "trigger": "score_reached",
    "condition": {
      "type": "score_threshold",
      "operator": ">=",
      "value": 1000
    },
    "consequence": [
      {
        "action": "emit_game_win",
        "data": {
          "reason": "score_goal",
          "final_score": 1000
        }
      },
      {
        "action": "show_message",
        "value": "Victory! Score goal reached!"
      }
    ],
    "priority": 100,
    "enabled": true,
    "max_triggers": 1,
    "metadata": {
      "description": "Player wins when reaching 1000 points",
      "category": "win_condition"
    }
  },
  {
    "rule_id": "spawn_obstacle_periodic",
    "trigger": "timeout",
    "condition": {
      "type": "time_elapsed",
      "operator": ">=",
      "value": 2000
    },
    "consequence": [
      {
        "action": "spawn_entity",
        "target": "obstacle",
        "data": {
          "position": [10, 0, 0],
          "type": "random"
        }
      }
    ],
    "priority": 40,
    "enabled": true,
    "cooldown_ms": 2000,
    "metadata": {
      "description": "Spawn obstacle every 2 seconds",
      "category": "spawning"
    }
  },
  {
    "rule_id": "player_jump_input",
    "trigger": "input_event",
    "condition": "key_pressed_space",
    "consequence": [
      {
        "action": "update_property",
        "target": "player",
        "property": "velocity_y",
        "value": 5
      },
      {
        "action": "emit_event",
        "event": "player_jumped"
      }
    ],
    "priority": 60,
    "enabled": true,
    "cooldown_ms": 500,
    "metadata": {
      "description": "Player jumps when space is pressed",
      "category": "input"
    }
  },
  {
    "rule_id": "game_start_setup",
    "trigger": "game_start",
    "condition": "always",
    "consequence": [
      {
        "action": "update_property",
        "target": "player",
        "property": "health",
        "value": 3
      },
      {
        "action": "update_property",
        "target": "player",
        "property": "score",
        "value": 0
      },
      {
        "action": "emit_event",
        "event": "game_initialized"
      }
    ],
    "priority": 100,
    "enabled": true,
    "max_triggers": 1,
    "metadata": {
      "description": "Initialize player stats at game start",
      "category": "initialization"
    }
  },
  {
    "rule_id": "obstacle_out_of_bounds",
    "trigger": "property_change",
    "condition": {
      "type": "property_threshold",
      "entities": ["obstacle"],
      "property": "position_x",
      "operator": "<",
      "value": -10
    },
    "consequence": [
      {
        "action": "destroy_entity",
        "target": "obstacle"
      }
    ],
    "priority": 30,
    "enabled": true,
    "metadata": {
      "description": "Remove obstacles that go off-screen",
      "category": "cleanup"
    }
  },
  {
    "rule_id": "combo_multiplier",
    "trigger": "collision",
    "condition": {
      "type": "entity_collision",
      "entities": ["player", "collectible"]
    },
    "consequence": [
      {
        "action": "update_property",
        "target": "player",
        "property": "combo",
        "value": "+1"
      },
      {
        "action": "increase_score",
        "amount": 10,
        "condition": "combo >= 3"
      },
      {
        "action": "show_message",
        "value": "Combo x3!",
        "condition": "combo == 3"
      }
    ],
    "priority": 75,
    "enabled": true,
    "cooldown_ms": 100,
    "metadata": {
      "description": "Combo multiplier for consecutive collectibles",
      "category": "scoring"
    }
  },
  {
    "rule_id": "pause_on_escape",
    "trigger": "input_event",
    "condition": "key_pressed_escape",
    "consequence": [
      {
        "action": "pause_game"
      },
      {
        "action": "emit_event",
        "event": "game_paused"
      }
    ],
    "priority": 95,
    "enabled": true,
    "metadata": {
      "description": "Pause game when escape key is pressed",
      "category": "control"
    }
  },
  {
    "rule_id": "difficulty_increase",
    "trigger": "score_reached",
    "condition": {
      "type": "score_threshold",
      "operator": ">=",
      "value": 500
    },
    "consequence": [
      {
        "action": "update_property",
        "target": "game",
        "property": "spawn_frequency",
        "value": 1.5
      },
      {
        "action": "update_property",
        "target": "game",
        "property": "movement_speed",
        "value": 10
      },
      {
        "action": "show_message",
        "value": "Difficulty increased!"
      }
    ],
    "priority": 65,
    "enabled": true,
    "max_triggers": 1,
    "metadata": {
      "description": "Increase difficulty at 500 points",
      "category": "difficulty"
    }
  }
]
